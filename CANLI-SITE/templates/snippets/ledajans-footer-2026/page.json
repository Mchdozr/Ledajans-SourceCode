\n        <div>\n          <a class=\"ledajans-footer-brand\" href=\"https://ledajans.com/\">\n            <img\n              src=\"https://ledajans.com/wp-content/uploads/2022/12/LedajansLogo.png\"\n              alt=\"LEDAJANS\"\n              class=\"ledajans-footer-logo\"\n            />\n          </a>\n          <p class=\"ledajans-footer-desc\">\n            LEDAJANS, LED ekran, kayan yazı ve dijital tabela sistemlerinde kullanılan LED modül, güç kaynağı, kontrol kartı ve aksesuar satışında Türkiye'nin güvenilir adresidir. Toptan ve perakende satış, teknik destek ve hızlı kargo ile sektör profesyonellerinin yanındadır.\n          </p>\n        </div>\n  \n        <div>\n          <h3 class=\"ledajans-footer-title\">Hızlı Linkler</h3>\n          <ul class=\"ledajans-footer-links\">\n            <li><a href=\"https://ledajans.com/\" class=\"ledajans-footer-link\">Anasayfa</a></li>\n            <li><a href=\"https://ledajans.com/hakkimizda/\" class=\"ledajans-footer-link\">Hakkımızda</a></li>\n            <li><a href=\"https://ledajans.com/firma-bilgilerimiz/\" class=\"ledajans-footer-link\">Firma Bilgilerimiz</a></li>\n            <li><a href=\"https://ledajans.com/blog/\" class=\"ledajans-footer-link\">Blog</a></li>\n            <li><a href=\"https://ledajans.com/iletisim/\" class=\"ledajans-footer-link\">İletişim</a></li>\n            <li><a href=\"https://ledajans.com/colorlight/\" class=\"ledajans-footer-link\">Colorlight</a></li>\n            <li><a href=\"https://ledajans.com/huidu-processor-hdplayer-indir/\" class=\"ledajans-footer-link\">Huidu</a></li>\n            <li><a href=\"https://drive.google.com/drive/folders/1zDVV7am98E-Q6AuEx3s6N66kjVlTVhQj?usp=sharing\" target=\"_blank\" rel=\"noopener\" class=\"ledajans-footer-link\">Google Drive</a></li>\n          </ul>\n        </div>\n  \n        <div>\n          <h3 class=\"ledajans-footer-title\">Galeri</h3>\n          <div class=\"ledajans-footer-gallery\">\n            <button type=\"button\" class=