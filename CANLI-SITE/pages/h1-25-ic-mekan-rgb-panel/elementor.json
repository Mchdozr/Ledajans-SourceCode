       "html": "<!-- LEDAJANS SEO - Sayfa Üstü Hero/Banner - H1.25 İç Mekan RGB Panel -->\n<style>\n.ledajans-blog-hero {\n  position: relative;\n  height: 200px;\n  background-image: url('https://ledajans.com/wp-content/uploads/2026/04/Firefly_Gemini-Flash_LEDAJANS-yazisi-tamamen-turuncu-olsun-o-kadar-13541.png');\n  background-size: cover;\n  background-position: center;\n  background-repeat: no-repeat;\n}\n@media (min-width: 640px) { .ledajans-blog-hero { height: 250px; } }\n@media (min-width: 768px) { .ledajans-blog-hero { height: 300px; } }\n.ledajans-blog-hero-overlay {\n  position: absolute;\n  inset: 0;\n  background: linear-gradient(135deg, rgba(26, 26, 46, 0.85), rgba(22, 33, 62, 0.8));\n  transition: background-color 0.3s;\n}\n.ledajans-blog-hero-inner {\n  position: relative;\n  height: 100%;\n  max-width: 80rem;\n  margin: 0 auto;\n  padding: 0 1rem;\n  display: flex;\n  align-items: center;\n}\n@media (min-width: 640px) { .ledajans-blog-hero-inner { padding: 0 1.5rem; } }\n@media (min-width: 1024px) { .ledajans-blog-hero-inner { padding: 0 2rem; } }\n.ledajans-blog-hero-content {\n  font-family: ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, \"Segoe UI\", Roboto, \"Helvetica Neue\", Arial, sans-serif;\n}\n.ledajans-blog-hero-title {\n  font-size: 2rem;\n  font-weight: 700;\n  color: #ffffff;\n  margin: 0;\n  letter-spacing: -0.025em;\n  line-height: 1.2;\n}\n@media (min-width: 640px) { .ledajans-blog-hero-title { font-size: 2.5rem; } }\n@media (min-width: 768px) { .ledajans-blog-hero-title { font-size: 3rem; } }\n.ledajans-blog-hero-subtitle {\n  display: block;\n  margin-top: 0.5rem;\n  font-size: 0.875rem;\n  font-weight: 400;\n  color: #d1d5db;\n  letter-spacing: -0.01em;\n  line-height: 1.5;\n}\n@media (min-width: 640px) { .ledajans-blog-hero-subtitle { font-size: 1rem; } }\n@media (min-width: 768px) { .ledajans-blog-hero-subtitle { font-size: 1.125rem; } }\n</style>\n<div class=\"ledajans-blog-hero\">\n<div class=\"ledajans-blog-hero-overlay\"></div>\n<div class=\"ledajans-blog-hero-inner\">\n<div class=\"ledajans-blog-hero-content\">\n<h1 class=\"ledajans-blog-hero-title\">H1.25 İç Mekan RGB Panel</h1>\n<span class=\"ledajans-blog-hero-subtitle\" style=\"color:#f46f2c\">1.25mm piksel aralığı, 640.000 piksel/m² – SMD1010 1R1G1B yapı, geniş görüş açısı ve IP67 koruma ile iç mekan LED ekran projeleri için güvenilir çözüm.</span>\n</div>\n</div>\n</div>"
