       "html": "<!-- LEDAJANS Firma Bilgilerimiz - Sayfa Üstü Hero/Banner -->\n<style>\n    .ledajans-firma-hero {\n      position: relative;\n      height: 200px;\n      background-image: url('https://ledajans.com/wp-content/uploads/2025/12/HEADER-4-scaled-1.jpg');\n      background-size: cover;\n      background-position: bottom;\n      background-repeat: no-repeat;\n    }\n    @media (min-width: 640px) { .ledajans-firma-hero { height: 250px; } }\n    @media (min-width: 768px) { .ledajans-firma-hero { height: 300px; } }\n    .ledajans-firma-hero-overlay {\n      position: absolute;\n      inset: 0;\n      background: linear-gradient(135deg, rgba(26, 26, 46, 0.85), rgba(22, 33, 62, 0.8));\n      transition: background-color 0.3s;\n    }\n    .ledajans-firma-hero-inner {\n      position: relative;\n      height: 100%;\n      max-width: 80rem;\n      margin: 0 auto;\n      padding: 0 1rem;\n      display: flex;\n      align-items: center;\n    }\n    @media (min-width: 640px) { .ledajans-firma-hero-inner { padding: 0 1.5rem; } }\n    @media (min-width: 1024px) { .ledajans-firma-hero-inner { padding: 0 2rem; } }\n    .ledajans-firma-hero-content {\n      font-family: ui-sans-serif, ui-sans-serif, -apple-system, BlinkMacSystemFont, \"Segoe UI\", Roboto, \"Helvetica Neue\", Arial, sans-serif;\n    }\n    .ledajans-firma-hero-title {\n      font-size: 2rem;\n      font-weight: 700;\n      color: #ffffff;\n      margin: 0;\n      letter-spacing: -0.025em;\n      line-height: 1.2;\n    }\n    @media (min-width: 640px) { .ledajans-firma-hero-title { font-size: 2.5rem; } }\n    @media (min-width: 768px) { .ledajans-firma-hero-title { font-size: 3rem; } }\n    .ledajans-firma-hero-subtitle {\n      display: block;\n      margin-top: 0.5rem;\n      font-size: 0.875rem;\n      font-weight: 400;\n      color: #f46f2c;\n      letter-spacing: -0.01em;\n      line-height: 1.5;\n    }\n    @media (min-width: 640px) { .ledajans-firma-hero-subtitle { font-size: 1rem; } }\n    @media (min-width: 768px) { .ledajans-firma-hero-subtitle { font-size: 1.125rem; } }\n    </style>\n    \n    <div class=\"ledajans-firma-hero\" role=\"img\" aria-label=\"LEDAJANS firma bilgileri\">\n      <div class=\"ledajans-firma-hero-overlay\"></div>\n      <div class=\"ledajans-firma-hero-inner\">\n        <div class=\"ledajans-firma-hero-content\">\n          <h1 class=\"ledajans-firma-hero-title\">Firma Bilgilerimiz</h1>\n          <span class=\"ledajans-firma-hero-subtitle\">Şirket bilgileri, banka hesapları ve iletişim detayları</span>\n        </div>\n      </div>\n    </div>\n\n<script type=\"application/ld+json\">\n{\n  \"@context\": \"https://schema.org\",\n  \"@type\": \"BreadcrumbList\",\n  \"itemListElement\": [\n    {\"@type\":\"ListItem\",\"position\":1,\"name\":\"Anasayfa\",\"item\":\"https://ledajans.com/\"},\n    {\"@type\":\"ListItem\",\"position\":2,\"name\":\"Kurumsal\",\"item\":\"https://ledajans.com/hakkimizda/\"},\n    {\"@type\":\"ListItem\",\"position\":3,\"name\":\"Firma Bilgilerimiz\",\"item\":\"https://ledajans.com/firma-bilgilerimiz/\"}\n  ]\n}\n</script>\n    "
