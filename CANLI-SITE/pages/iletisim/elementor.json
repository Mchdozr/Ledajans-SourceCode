       "html": "<link rel=\"preload\" as=\"image\" href=\"https://images.pexels.com/photos/3184418/pexels-photo-3184418.jpeg?auto=compress&cs=tinysrgb&w=1920\">\n<div class=\"ledajans-iletisim-hero\" role=\"img\" aria-label=\"LEDAJANS iletişim\">\n    <div class=\"ledajans-iletisim-hero-overlay\"></div>\n    <div class=\"ledajans-iletisim-hero-icerik\">\n      <div>\n        <h1 class=\"ledajans-iletisim-hero-baslik\">İletişim</h1>\n        <p class=\"ledajans-iletisim-hero-alt\">Bize Ulaşın</p>\n      </div>\n    </div>\n  </div>\n  \n  <style>\n  .ledajans-iletisim-hero {\n    position: relative;\n    height: 200px;\n    background-image: url('https://images.pexels.com/photos/3184418/pexels-photo-3184418.jpeg?auto=compress&cs=tinysrgb&w=1920');\n    background-size: cover;\n    background-position: center;\n    margin-bottom: 1.5rem;\n  }\n  @media (min-width: 640px) { .ledajans-iletisim-hero { height: 250px; } }\n  @media (min-width: 768px) { .ledajans-iletisim-hero { height: 300px; } }\n  \n  .ledajans-iletisim-hero-overlay {\n    position: absolute;\n    inset: 0;\n    background: linear-gradient(to right, rgba(17,24,39,0.95), rgba(17,24,39,0.7));\n  }\n  \n  .ledajans-iletisim-hero-icerik {\n    position: relative;\n    height: 100%;\n    max-width: 80rem;\n    margin: 0 auto;\n    padding: 0 1rem;\n    display: flex;\n    align-items: center;\n  }\n  @media (min-width: 640px) { .ledajans-iletisim-hero-icerik { padding: 0 1.5rem; } }\n  @media (min-width: 1024px) { .ledajans-iletisim-hero-icerik { padding: 0 2rem; } }\n  \n  .ledajans-iletisim-hero-baslik {\n    margin: 0 0 0.5rem 0;\n    color: #ffffff;\n    font-weight: 700;\n    letter-spacing: -0.03em;\n    font-size: 1.875rem; /* ~text-3xl */\n  }\n  @media (min-width: 640px) { .ledajans-iletisim-hero-baslik { font-size: 2.25rem; } }  /* 4xl */\n  @media (min-width: 768px) { .ledajans-iletisim-hero-baslik { font-size: 3rem; } }     /* 5xl */\n  @media (min-width: 1024px) { .ledajans-iletisim-hero-baslik { font-size: 3.75rem; } } /* 6xl */\n  \n  .ledajans-iletisim-hero-alt {\n    margin: 0;\n    color: #F46F2C;\n    font-weight: 300;\n    font-size: 1.125rem; /* text-lg */\n  }\n  @media (min-width: 640px) { .ledajans-iletisim-hero-alt { font-size: 1.25rem; } } /* xl */\n  @media (min-width: 768px) { .ledajans-iletisim-hero-alt { font-size: 1.5rem; } }  /* 2xl */\n  </style>\n\n<script type=\"application/ld+json\">\n{\n  \"@context\": \"https://schema.org\",\n  \"@type\": \"BreadcrumbList\",\n  \"itemListElement\": [\n    {\"@type\":\"ListItem\",\"position\":1,\"name\":\"Anasayfa\",\"item\":\"https://ledajans.com/\"},\n    {\"@type\":\"ListItem\",\"position\":2,\"name\":\"İletişim\",\"item\":\"https://ledajans.com/iletisim/\"}\n  ]\n}\n</script>"
