       "html": "<!-- LEDAJANS /led-ekran/ — Elementor HTML widget (Görsel sekme kullanma, TinyMCE CSS'i bozar) -->\r\n<style>\r\n  body.page-id-5001 .page-title,\r\n  body.page-id-5001 .page-title h1,\r\n  body.page-id-5001 .gva-breadcrumb-content h1,\r\n  body.page-id-5001 header.entry-header h1,\r\n  body.page-id-5001 .title-info > h1.title { display: none !important; }\r\n\r\n  .la-wrapper {\r\n    --la-orange: #F46F2C;\r\n    --la-dark: #111827;\r\n    --la-gray: #4B5563;\r\n    --la-light: #F9FAFB;\r\n    font-family: system-ui, -apple-system, BlinkMacSystemFont, \"Segoe UI\", Roboto, sans-serif;\r\n    color: #1f2937;\r\n    line-height: 1.7;\r\n    max-width: 1280px;\r\n    margin: 0 auto;\r\n    padding: 0 1rem 2rem;\r\n  }\r\n  .la-section {\r\n    padding: 4rem 0;\r\n    border-bottom: 1px solid #f3f4f6;\r\n  }\r\n  .la-section:last-of-type { border-bottom: none; }\r\n\r\n  @keyframes la-shine {\r\n    0% { background-position: 0% 50%; }\r\n    50% { background-position: 100% 50%; }\r\n    100% { background-position: 0% 50%; }\r\n  }\r\n  .la-gradient-title {\r\n    font-size: clamp(2rem, 4.5vw, 3.4rem);\r\n    font-weight: 900;\r\n    margin: 0 0 1.25rem;\r\n    line-height: 1.15;\r\n    background: linear-gradient(90deg, #F46F2C, #ff8f5e, #F46F2C);\r\n    background-size: 200% auto;\r\n    -webkit-background-clip: text;\r\n    background-clip: text;\r\n    -webkit-text-fill-color: transparent;\r\n    animation: la-shine 4s linear infinite;\r\n    text-align: center;\r\n  }\r\n  @media (prefers-reduced-motion: reduce) {\r\n    .la-gradient-title { animation: none; background-position: 50% 50%; }\r\n  }\r\n\r\n  .la-hero {\r\n    background: linear-gradient(160deg, #111827 0%, #0f172a 55%, #1a120c 100%);\r\n    border-radius: 1.75rem;\r\n    padding: clamp(2.5rem, 5vw, 4.5rem) 1.5rem 3rem;\r\n    color: #fff;\r\n    text-align: center;\r\n    margin: 0 0 1rem;\r\n    position: relative;\r\n    overflow: hidden;\r\n    box-shadow: 0 24px 48px -16px rgba(0, 0, 0, 0.28);\r\n  }\r\n  .la-hero::before {\r\n    content: \"\";\r\n    position: absolute;\r\n    top: -40%;\r\n    right: -18%;\r\n    width: 640px;\r\n    height: 640px;\r\n    background: radial-gradient(circle, rgba(244,111,44,0.16) 0%, transparent 68%);\r\n    pointer-events: none;\r\n  }\r\n  .la-hero-desc {\r\n    position: relative;\r\n    font-size: 1.15rem;\r\n    color: #d1d5db;\r\n    max-width: 760px;\r\n    margin: 0 auto 2rem;\r\n    font-weight: 400;\r\n  }\r\n  .la-hero-actions {\r\n    position: relative;\r\n    display: flex;\r\n    flex-wrap: wrap;\r\n    gap: 0.75rem;\r\n    justify-content: center;\r\n  }\r\n  .la-hero-chips {\r\n    position: relative;\r\n    margin: 1.75rem 0 0;\r\n    font-size: 0.95rem;\r\n    color: #9ca3af;\r\n  }\r\n  .la-hero-chips a {\r\n    color: #fdba74;\r\n    text-decoration: none;\r\n    font-weight: 600;\r\n  }\r\n  .la-hero-chips a:hover { color: #fff; text-decoration: underline; }\r\n\r\n  .la-btn {\r\n    display: inline-flex;\r\n    align-items: center;\r\n    justify-content: center;\r\n    min-height: 52px;\r\n    padding: 0.85rem 1.6rem;\r\n    border-radius: 0.9rem;\r\n    font-weight: 700;\r\n    font-size: 1rem;\r\n    text-decoration: none !important;\r\n    transition: transform 0.2s ease, box-shadow 0.2s ease, background 0.2s ease;\r\n  }\r\n  .la-btn-primary {\r\n    background: var(--la-orange);\r\n    color: #fff !important;\r\n    border: 2px solid var(--la-orange);\r\n    box-shadow: 0 10px 18px -6px rgba(244, 111, 44, 0.45);\r\n  }\r\n  .la-btn-primary:hover {\r\n    background: #d1561b;\r\n    border-color: #d1561b;\r\n    color: #fff !important;\r\n    transform: translateY(-2px);\r\n  }\r\n  .la-btn-outline {\r\n    background: transparent;\r\n    color: #fff !important;\r\n    border: 2px solid rgba(255,255,255,0.22);\r\n  }\r\n  .la-btn-outline:hover {\r\n    background: rgba(255,255,255,0.1);\r\n    border-color: #fff;\r\n    color: #fff !important;\r\n  }\r\n\r\n  .la-table-wrap { overflow-x: auto; -webkit-overflow-scrolling: touch; max-width: 920px; margin: 0 auto; }\r\n  .la-table { width: 100%; border-collapse: collapse; margin: 1.25rem 0 0; font-size: 0.95rem; min-width: 560px; }\r\n  .la-table th, .la-table td { border: 1px solid #e5e7eb; padding: 0.75rem 0.85rem; text-align: left; }\r\n  .la-table thead { background: #111827; color: #fff; }\r\n  .la-table tbody tr:nth-child(even) { background: #f9fafb; }\r\n  .la-table a { color: #c2410c; font-weight: 600; text-decoration: none; }\r\n  .la-table a:hover { text-decoration: underline; }\r\n\r\n  .la-grid-3 {\r\n    display: grid;\r\n    grid-template-columns: 1fr;\r\n    gap: 1.5rem;\r\n  }\r\n  @media (min-width: 768px) {\r\n    .la-grid-3 { grid-template-columns: repeat(3, 1fr); gap: 1.75rem; }\r\n  }\r\n\r\n  a.la-card {\r\n    background: #fff;\r\n    border-radius: 1.25rem;\r\n    overflow: hidden;\r\n    border: 1px solid #e5e7eb;\r\n    transition: transform 0.25s ease, box-shadow 0.25s ease, border-color 0.25s ease;\r\n    height: 100%;\r\n    display: flex;\r\n    flex-direction: column;\r\n    text-decoration: none !important;\r\n    color: inherit;\r\n    box-shadow: 0 4px 14px rgba(17, 24, 39, 0.05);\r\n  }\r\n  a.la-card:hover {\r\n    transform: translateY(-6px);\r\n    box-shadow: 0 22px 40px -16px rgba(17, 24, 39, 0.18);\r\n    border-color: var(--la-orange);\r\n  }\r\n  a.la-card:focus-visible { outline: 3px solid #f46f2c; outline-offset: 3px; }\r\n  .la-card-img-wrapper {\r\n    position: relative;\r\n    aspect-ratio: 16 / 9;\r\n    overflow: hidden;\r\n    background: #111827;\r\n  }\r\n  .la-card-img {\r\n    width: 100%;\r\n    height: 100%;\r\n    object-fit: cover;\r\n    object-position: center;\r\n    display: block;\r\n    transition: transform 0.4s ease;\r\n  }\r\n  a.la-card:hover .la-card-img { transform: scale(1.04); }\r\n  .la-card-body {\r\n    padding: 1.35rem 1.4rem 1.5rem;\r\n    flex-grow: 1;\r\n    display: flex;\r\n    flex-direction: column;\r\n  }\r\n  .la-card-title {\r\n    font-size: 1.2rem;\r\n    font-weight: 800;\r\n    color: var(--la-dark);\r\n    margin: 0 0 0.6rem;\r\n    line-height: 1.3;\r\n  }\r\n  .la-card-text {\r\n    color: var(--la-gray);\r\n    margin: 0 0 1rem;\r\n    flex-grow: 1;\r\n    font-size: 0.98rem;\r\n  }\r\n  .la-link {\r\n    color: var(--la-orange);\r\n    font-weight: 700;\r\n    display: inline-flex;\r\n    align-items: center;\r\n    gap: 0.4rem;\r\n    margin-top: auto;\r\n  }\r\n  .la-link-icon {\r\n    display: inline-flex;\r\n    width: 1.25rem;\r\n    height: 1.25rem;\r\n    border-radius: 999px;\r\n    border: 1px solid rgba(244, 111, 44, 0.4);\r\n    background: rgba(244, 111, 44, 0.08);\r\n    align-items: center;\r\n    justify-content: center;\r\n    font-size: 0.75rem;\r\n  }\r\n\r\n  .la-content-wrapper {\r\n    display: grid;\r\n    grid-template-columns: 1fr;\r\n    gap: 2.5rem;\r\n    align-items: center;\r\n  }\r\n  @media (min-width: 1024px) {\r\n    .la-content-wrapper { grid-template-columns: 1.05fr 0.95fr; gap: 3.5rem; }\r\n  }\r\n  .la-section-header {\r\n    font-size: clamp(1.6rem, 3vw, 2.15rem);\r\n    font-weight: 800;\r\n    color: var(--la-dark);\r\n    margin: 0 0 1rem;\r\n    line-height: 1.2;\r\n  }\r\n  .la-lede {\r\n    font-size: 1.05rem;\r\n    color: #6b7280;\r\n    max-width: 700px;\r\n    margin: 0 auto;\r\n  }\r\n  .la-text-block p { margin: 0 0 1.15rem; font-size: 1.05rem; color: #374151; }\r\n  .la-text-block a { color: var(--la-orange); font-weight: 600; }\r\n  .la-checks { list-style: none; padding: 0; margin: 1.5rem 0 0; display: grid; gap: 0.75rem; }\r\n  .la-checks li { display: flex; align-items: center; gap: 0.75rem; font-weight: 600; }\r\n  .la-checks span { color: var(--la-orange); }\r\n\r\n  .la-guide-grid {\r\n    display: grid;\r\n    grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));\r\n    gap: 0.85rem;\r\n    max-width: 1100px;\r\n    margin: 0 auto;\r\n  }\r\n  a.la-guide {\r\n    display: block;\r\n    padding: 1.15rem 1.2rem;\r\n    border: 1px solid #e5e7eb;\r\n    border-radius: 1rem;\r\n    text-decoration: none !important;\r\n    color: #111827;\r\n    background: #fff;\r\n    transition: border-color 0.2s, box-shadow 0.2s, transform 0.2s;\r\n  }\r\n  a.la-guide:hover {\r\n    border-color: #f46f2c;\r\n    box-shadow: 0 10px 24px rgba(17, 24, 39, 0.08);\r\n    transform: translateY(-2px);\r\n  }\r\n  a.la-guide strong { color: #c2410c; display: block; }\r\n  a.la-guide span { display: block; margin-top: 0.4rem; font-size: 0.9rem; color: #6b7280; font-weight: 400; }\r\n\r\n  .la-faq-wrap {\r\n    background: #f9fafb;\r\n    border-radius: 1.5rem;\r\n    padding: clamp(2rem, 4vw, 3.5rem) 1.25rem;\r\n  }\r\n  .la-faq-item {\r\n    background: #fff;\r\n    border-radius: 0.9rem;\r\n    margin: 0 0 0.75rem;\r\n    border: 1px solid #e5e7eb;\r\n    padding: 0;\r\n    max-width: 900px;\r\n    margin-left: auto;\r\n    margin-right: auto;\r\n    margin-bottom: 0.75rem;\r\n  }\r\n  .la-faq-item summary {\r\n    cursor: pointer;\r\n    font-weight: 700;\r\n    font-size: 1.08rem;\r\n    color: var(--la-dark);\r\n    padding: 1.1rem 1.25rem;\r\n    list-style: none;\r\n  }\r\n  .la-faq-item summary::-webkit-details-marker { display: none; }\r\n  .la-faq-item p { margin: 0; padding: 0 1.25rem 1.2rem; color: #374151; }\r\n  .la-faq-item a { color: #c2410c; font-weight: 600; }\r\n\r\n  .la-cta-box {\r\n    background: linear-gradient(135deg, #111827 0%, #000 100%);\r\n    border-radius: 1.75rem;\r\n    padding: clamp(2.5rem, 5vw, 4.5rem) 1.5rem;\r\n    text-align: center;\r\n    margin-top: 2rem;\r\n  }\r\n  .la-cta-box .la-gradient-title { margin-bottom: 1rem; }\r\n  .la-cta-box p { font-size: 1.15rem; color: #d1d5db; margin: 0 auto 1.75rem; max-width: 680px; }\r\n\r\n  .la-seo-img {\r\n    width: 100%;\r\n    height: auto;\r\n    aspect-ratio: 16 / 9;\r\n    object-fit: cover;\r\n    border-radius: 1.5rem;\r\n    box-shadow: 0 22px 44px -16px rgba(0,0,0,0.22);\r\n    display: block;\r\n  }\r\n\r\n  @media (max-width: 640px) {\r\n    .la-btn { width: 100%; }\r\n  }\r\n</style>\r\n\r\n<div class=\"la-wrapper\">\r\n\r\n  <div class=\"la-hero\">\r\n    <h1 class=\"la-gradient-title\">LED Ekran Çözümleri</h1>\r\n    <p class=\"la-hero-desc\"><strong>LED ekran fiyatları</strong>, m² hesaplama ve proje danışmanlığı — iç mekan, dış mekan ve rental. 25 yıllık üretici tecrübesi, Türkiye geneli kurulum, 2 yıl garanti.</p>\r\n    <div class=\"la-hero-actions\">\r\n      <a class=\"la-btn la-btn-primary\" href=\"https://ledajans.com/iletisim/\">Fiyat teklifi al</a>\r\n      <a class=\"la-btn la-btn-outline\" href=\"https://ledajans.com/led-ekran-fiyatlari-2026/\">2026 fiyat rehberi</a>\r\n      <a class=\"la-btn la-btn-outline\" href=\"https://ledajans.com/projeler/\">Projeleri incele</a>\r\n      <a class=\"la-btn la-btn-outline\" href=\"tel:+902122204004\">0212 220 40 04</a>\r\n    </div>\r\n    <p class=\"la-hero-chips\">\r\n      <a href=\"https://ledajans.com/ic-mekan-led-ekran/\">İç mekan</a> ·\r\n      <a href=\"https://ledajans.com/dis-mekan-led-ekran/\">Dış mekan</a> ·\r\n      <a href=\"https://ledajans.com/rental-ekran/\">Rental</a> ·\r\n      <a href=\"https://ledajans.com/cob-ekran/\">COB</a> ·\r\n      <a href=\"https://ledajans.com/gob-led-ekran/\">GOB</a> ·\r\n      <a href=\"https://ledajans.com/led-ekran-nedir/\">LED ekran nedir?</a>\r\n    </p>\r\n  </div>\r\n\r\n  <div class=\"la-section\">\r\n    <div style=\"text-align:center;margin-bottom:2.25rem;\">\r\n      <h2 class=\"la-section-header\">İhtiyacınıza uygun LED ekran modelleri</h2>\r\n      <p class=\"la-lede\">Kullanım alanına göre pitch, kasa ve parlaklık. Karttan ürün sayfasına geçin.</p>\r\n    </div>\r\n    <div class=\"la-grid-3\">\r\n      <a class=\"la-card\" href=\"https://ledajans.com/ic-mekan-led-ekran/\">\r\n        <div class=\"la-card-img-wrapper\">\r\n          <img class=\"la-card-img\" src=\"https://ledajans.com/wp-content/uploads/2026/09/ic-mekan-led-ekran-1.webp\" alt=\"İç mekan LED ekran\" width=\"1280\" height=\"720\" fetchpriority=\"high\" decoding=\"async\">\r\n        </div>\r\n        <div class=\"la-card-body\">\r\n          <h3 class=\"la-card-title\">İç mekan (indoor) LED ekran</h3>\r\n          <p class=\"la-card-text\">Mağaza, toplantı ve stüdyo için <strong>P1.25, P2, P2.5</strong>. İnce kasa, sessiz çalışma, 3840 Hz tazeleme.</p>\r\n          <span class=\"la-link\">Modelleri incele <span class=\"la-link-icon\" aria-hidden=\"true\">➜</span></span>\r\n        </div>\r\n      </a>\r\n      <a class=\"la-card\" href=\"https://ledajans.com/dis-mekan-led-ekran/\">\r\n        <div class=\"la-card-img-wrapper\">\r\n          <img class=\"la-card-img\" src=\"https://ledajans.com/wp-content/uploads/2026/09/dis-mekan-led-ekran-1.webp\" alt=\"Dış mekan LED ekran\" width=\"1280\" height=\"720\" loading=\"lazy\" decoding=\"async\">\r\n        </div>\r\n        <div class=\"la-card-body\">\r\n          <h3 class=\"la-card-title\">Dış mekan (outdoor) LED ekran</h3>\r\n          <p class=\"la-card-text\">5000+ nits, <strong>IP65</strong>. Pano, totem ve stadyum için <strong>P4–P10</strong>.</p>\r\n          <span class=\"la-link\">Modelleri incele <span class=\"la-link-icon\" aria-hidden=\"true\">➜</span></span>\r\n        </div>\r\n      </a>\r\n      <a class=\"la-card\" href=\"https://ledajans.com/rental-ekran/\">\r\n        <div class=\"la-card-img-wrapper\">\r\n          <img class=\"la-card-img\" src=\"https://ledajans.com/wp-content/uploads/2026/09/rental-led-sahne.webp\" alt=\"Rental LED ekran kiralama\" width=\"1280\" height=\"720\" loading=\"lazy\" decoding=\"async\">\r\n        </div>\r\n        <div class=\"la-card-body\">\r\n          <h3 class=\"la-card-title\">Rental (kiralık) LED ekran</h3>\r\n          <p class=\"la-card-text\">Konser ve fuar için die-cast alüminyum kasa, hızlı kilit, flight case.</p>\r\n          <span class=\"la-link\">Modelleri incele <span class=\"la-link-icon\" aria-hidden=\"true\">➜</span></span>\r\n        </div>\r\n      </a>\r\n      <a class=\"la-card\" href=\"https://ledajans.com/cob-ekran/\">\r\n        <div class=\"la-card-img-wrapper\">\r\n          <img class=\"la-card-img\" src=\"https://ledajans.com/wp-content/uploads/2026/09/cob-led-ekran-nedir.webp\" alt=\"COB Smart Screen LED ekran\" width=\"1280\" height=\"720\" loading=\"lazy\" decoding=\"async\">\r\n        </div>\r\n        <div class=\"la-card-body\">\r\n          <h3 class=\"la-card-title\">COB – Smart Screen</h3>\r\n          <p class=\"la-card-text\">Premium yüzey, darbe dayanımı. Kontrol odası ve kurumsal iç mekan.</p>\r\n          <span class=\"la-link\">Modelleri incele <span class=\"la-link-icon\" aria-hidden=\"true\">➜</span></span>\r\n        </div>\r\n      </a>\r\n      <a class=\"la-card\" href=\"https://ledajans.com/ic-mekan-rgb-panel/\">\r\n        <div class=\"la-card-img-wrapper\">\r\n          <img class=\"la-card-img\" src=\"https://ledajans.com/wp-content/uploads/2026/09/ic-mekan-rgb-panel-1.webp\" alt=\"İç mekan RGB LED panel\" width=\"1280\" height=\"720\" loading=\"lazy\" decoding=\"async\">\r\n        </div>\r\n        <div class=\"la-card-body\">\r\n          <h3 class=\"la-card-title\">İç mekan RGB panel</h3>\r\n          <p class=\"la-card-text\">Showroom ve mağaza için renk tutarlı indoor RGB modül.</p>\r\n          <span class=\"la-link\">Modelleri incele <span class=\"la-link-icon\" aria-hidden=\"true\">➜</span></span>\r\n        </div>\r\n      </a>\r\n      <a class=\"la-card\" href=\"https://ledajans.com/dis-mekan-rgb-panel/\">\r\n        <div class=\"la-card-img-wrapper\">\r\n          <img class=\"la-card-img\" src=\"https://ledajans.com/wp-content/uploads/2026/09/dis-mekan-rgb-panel-1.webp\" alt=\"Dış mekan RGB LED panel\" width=\"1280\" height=\"720\" loading=\"lazy\" decoding=\"async\">\r\n        </div>\r\n        <div class=\"la-card-body\">\r\n          <h3 class=\"la-card-title\">Dış mekan RGB panel</h3>\r\n          <p class=\"la-card-text\">Yüksek parlaklık, hava koşullarına dayanıklı outdoor RGB.</p>\r\n          <span class=\"la-link\">Modelleri incele <span class=\"la-link-icon\" aria-hidden=\"true\">➜</span></span>\r\n        </div>\r\n      </a>\r\n    </div>\r\n  </div>\r\n\r\n  <div class=\"la-section\">\r\n    <div style=\"text-align:center;margin-bottom:2.25rem;\">\r\n      <h2 class=\"la-section-header\">Kullanım senaryoları</h2>\r\n      <p class=\"la-lede\">Aynı arama, üç niyet: vitrin, cephe, fuar. Doğru sayfadan teklif alın.</p>\r\n    </div>\r\n    <div class=\"la-grid-3\">\r\n      <a class=\"la-card\" href=\"https://ledajans.com/magaza-vitrin-led-ekran/\">\r\n        <div class=\"la-card-img-wrapper\">\r\n          <img class=\"la-card-img\" src=\"https://ledajans.com/wp-content/uploads/2026/09/magaza-vitrin-led-cadde-1.webp\" alt=\"Mağaza vitrin LED ekran\" width=\"1280\" height=\"720\" loading=\"lazy\" decoding=\"async\">\r\n        </div>\r\n        <div class=\"la-card-body\">\r\n          <h3 class=\"la-card-title\">Mağaza / vitrin</h3>\r\n          <p class=\"la-card-text\">Göz hizası, cam yansıması, P1.25–P2.5 indoor.</p>\r\n          <span class=\"la-link\">Mağaza çözümü <span class=\"la-link-icon\" aria-hidden=\"true\">➜</span></span>\r\n        </div>\r\n      </a>\r\n      <a class=\"la-card\" href=\"https://ledajans.com/cephe-led-ekran/\">\r\n        <div class=\"la-card-img-wrapper\">\r\n          <img class=\"la-card-img\" src=\"https://ledajans.com/wp-content/uploads/2026/09/cephe-led-ekran.webp\" alt=\"Cephe LED ekran\" width=\"1280\" height=\"720\" loading=\"lazy\" decoding=\"async\">\r\n        </div>\r\n        <div class=\"la-card-body\">\r\n          <h3 class=\"la-card-title\">Cephe / billboard</h3>\r\n          <p class=\"la-card-text\">IP65, 5000+ nits, P4–P10 açık hava.</p>\r\n          <span class=\"la-link\">Cephe çözümü <span class=\"la-link-icon\" aria-hidden=\"true\">➜</span></span>\r\n        </div>\r\n      </a>\r\n      <a class=\"la-card\" href=\"https://ledajans.com/fuar-led-ekran/\">\r\n        <div class=\"la-card-img-wrapper\">\r\n          <img class=\"la-card-img\" src=\"https://ledajans.com/wp-content/uploads/2026/09/fuar-led-ekran-stand.webp\" alt=\"Fuar LED ekran stand\" width=\"1280\" height=\"720\" loading=\"lazy\" decoding=\"async\">\r\n        </div>\r\n        <div class=\"la-card-body\">\r\n          <h3 class=\"la-card-title\">Fuar / sahne</h3>\r\n          <p class=\"la-card-text\">Rental kabin, 2–4 saat kurulum. Kiralama veya satış.</p>\r\n          <span class=\"la-link\">Fuar çözümü <span class=\"la-link-icon\" aria-hidden=\"true\">➜</span></span>\r\n        </div>\r\n      </a>\r\n    </div>\r\n  </div>\r\n\r\n  <div class=\"la-section\" style=\"padding:2.5rem 0;\">\r\n    <h2 class=\"la-section-header\" style=\"text-align:center;\">LED ekran m² fiyatı nasıl okunur?</h2>\r\n    <p class=\"la-lede\" style=\"margin-bottom:1rem;\">Liste m² tek başına teklif değildir. Pitch + kasa + kontrol + kurulum toplamı fiyatı belirler.</p>\r\n    <div class=\"la-table-wrap\">\r\n      <table class=\"la-table\">\r\n        <thead>\r\n          <tr><th>Niyet</th><th>Tip</th><th>Pitch</th><th>Fiyat sayfası</th></tr>\r\n        </thead>\r\n        <tbody>\r\n          <tr>\r\n            <td>İç mekan / mağaza</td>\r\n            <td><a href=\"https://ledajans.com/ic-mekan-led-ekran/\">İç mekan LED ekran</a></td>\r\n            <td>P1.25–P3</td>\r\n            <td><a href=\"https://ledajans.com/ic-mekan-led-ekran-fiyatlari-2026/\">İç mekan m² rehberi</a></td>\r\n          </tr>\r\n          <tr>\r\n            <td>Cephe / outdoor</td>\r\n            <td><a href=\"https://ledajans.com/dis-mekan-led-ekran/\">Dış mekan LED ekran</a></td>\r\n            <td>P4–P10 · IP65</td>\r\n            <td><a href=\"https://ledajans.com/dis-mekan-led-ekran-fiyatlari-2026/\">Dış mekan m² rehberi</a></td>\r\n          </tr>\r\n          <tr>\r\n            <td>Fuar / kiralama</td>\r\n            <td><a href=\"https://ledajans.com/rental-ekran/\">Rental LED ekran</a></td>\r\n            <td>P2.6–P3.9</td>\r\n            <td><a href=\"https://ledajans.com/rental-led-ekran-kiralama-fiyatlari-2026/\">Kiralama fiyatları</a></td>\r\n          </tr>\r\n        </tbody>\r\n      </table>\r\n    </div>\r\n    <p style=\"text-align:center;margin:1.25rem 0 0;\">\r\n      <a href=\"https://ledajans.com/led-ekran-fiyatlari-2026/\" style=\"color:#c2410c;font-weight:700;\">LED ekran fiyatları 2026</a> ·\r\n      <a href=\"https://ledajans.com/pitch-secim-rehberi/\" style=\"color:#c2410c;font-weight:700;\">Pitch seçim rehberi</a>\r\n    </p>\r\n  </div>\r\n\r\n  <div class=\"la-section\">\r\n    <div class=\"la-content-wrapper\">\r\n      <div class=\"la-text-block\">\r\n        <h2 class=\"la-section-header\">LED ekran nedir, işletmeye ne katar?</h2>\r\n        <p><strong>LED ekran</strong>, LED çiplerinin modül üzerinde birleşmesiyle oluşan dijital görüntü yüzeyidir. Sabit tabelaya göre video ve dinamik içerik yayınlar. Ayrıntılı tanım: <a href=\"https://ledajans.com/led-ekran-nedir/\">LED ekran nedir rehberi</a>.</p>\r\n        <p><a href=\"https://ledajans.com/\">LEDAJANS</a> sistemleri istenen ölçüde üretilir. <a href=\"https://ledajans.com/ic-mekan-led-ekran/\">İç mekan</a> mağaza ve stüdyoda, <a href=\"https://ledajans.com/dis-mekan-led-ekran/\">dış mekan</a> pano ve stadyumda, kısa işler için <a href=\"https://ledajans.com/rental-ekran/\">rental kiralama</a> kullanılır.</p>\r\n        <ul class=\"la-checks\">\r\n          <li><span>✓</span> 100.000 saate varan ömür</li>\r\n          <li><span>✓</span> Düşük enerji (eco modül)</li>\r\n          <li><span>✓</span> Uzaktan yönetim yazılımı</li>\r\n        </ul>\r\n      </div>\r\n      <div>\r\n        <img class=\"la-seo-img\" src=\"https://ledajans.com/wp-content/uploads/2026/09/dis-mekan-led-ekran-1.webp\" alt=\"Dış mekan LED ekran kurulumu\" width=\"1280\" height=\"720\" loading=\"lazy\" decoding=\"async\">\r\n      </div>\r\n    </div>\r\n  </div>\r\n\r\n  <div class=\"la-section\" style=\"padding:2.5rem 0;\">\r\n    <h2 class=\"la-section-header\" style=\"text-align:center;margin-bottom:1.5rem;\">Rehberler ve fiyat</h2>\r\n    <div class=\"la-guide-grid\">\r\n      <a class=\"la-guide\" href=\"https://ledajans.com/led-ekran-nedir/\"><strong>LED ekran nedir?</strong><span>Türler, kullanım, seçim</span></a>\r\n      <a class=\"la-guide\" href=\"https://ledajans.com/led-ekran-fiyatlari-2026/\"><strong>LED ekran fiyatları 2026</strong><span>İç / dış / rental bütçe</span></a>\r\n      <a class=\"la-guide\" href=\"https://ledajans.com/led-ekran-nasil-secilir-rehber/\"><strong>LED ekran nasıl seçilir?</strong><span>P değeri, kasa, kontrol</span></a>\r\n      <a class=\"la-guide\" href=\"https://ledajans.com/ic-mekan-led-ekran-fiyatlari-2026/\"><strong>İç mekan fiyat rehberi</strong><span>P0.93–P5 m² aralıkları</span></a>\r\n      <a class=\"la-guide\" href=\"https://ledajans.com/dis-mekan-led-ekran-fiyatlari-2026/\"><strong>Dış mekan fiyat rehberi</strong><span>IP65, P4–P10</span></a>\r\n      <a class=\"la-guide\" href=\"https://ledajans.com/rental-led-ekran-kiralama-fiyatlari-2026/\"><strong>Rental kiralama fiyatları</strong><span>Gün + m² + lokasyon</span></a>\r\n      <a class=\"la-guide\" href=\"https://ledajans.com/fuar-led-ekran/\"><strong>Fuar LED ekran</strong><span>Stand ve etkinlik</span></a>\r\n      <a class=\"la-guide\" href=\"https://ledajans.com/magaza-vitrin-led-ekran/\"><strong>Mağaza / vitrin</strong><span>Indoor vitrin ve AVM</span></a>\r\n      <a class=\"la-guide\" href=\"https://ledajans.com/cephe-led-ekran/\"><strong>Cephe LED ekran</strong><span>Dış cephe ve billboard</span></a>\r\n      <a class=\"la-guide\" href=\"https://ledajans.com/pitch-secim-rehberi/\"><strong>Pitch seçim rehberi</strong><span>P2, P2.5, P3, P4–P10</span></a>\r\n      <a class=\"la-guide\" href=\"https://ledajans.com/gob-led-ekran/\"><strong>GOB LED ekran</strong><span>Darbe ve nem koruması</span></a>\r\n      <a class=\"la-guide\" href=\"https://ledajans.com/istanbul-led-ekran/\"><strong>İstanbul LED ekran</strong><span>Şişli üretim + kurulum</span></a>\r\n    </div>\r\n  </div>\r\n\r\n  <div class=\"la-section la-faq-wrap\">\r\n    <div style=\"text-align:center;margin-bottom:1.75rem;\">\r\n      <h2 class=\"la-section-header\">LED ekran hakkında merak edilenler</h2>\r\n      <p class=\"la-lede\">Satın almadan önce en sık sorulan üç başlık.</p>\r\n    </div>\r\n    <details class=\"la-faq-item\" open>\r\n      <summary>LED ekran m² fiyatları neye göre değişir?</summary>\r\n      <p><strong>LED ekran fiyatları</strong> pitch (P küçüldükçe artar), ölçü, çip kalitesi ve kontrol kartına (Novastar, Huidu) göre değişir. Net rakam için <a href=\"https://ledajans.com/iletisim/\">teklif alın</a> veya <a href=\"https://ledajans.com/led-ekran-fiyatlari-2026/\">2026 fiyat rehberine</a> bakın.</p>\r\n    </details>\r\n    <details class=\"la-faq-item\">\r\n      <summary>Piksel (P) değeri nedir, hangisini seçmeliyim?</summary>\r\n      <p>İki LED arası mm. Mesafe kısaldıkça P düşer. Tablo: <a href=\"https://ledajans.com/pitch-secim-rehberi/\">pitch seçim rehberi</a>. Yakın (2–5 m): P1.8–P2.5. Orta (5–10 m): P3–P5. Uzak (10 m+): P6–P10.</p>\r\n    </details>\r\n    <details class=\"la-faq-item\">\r\n      <summary>Garanti ve teknik servis nasıl işler?</summary>\r\n      <p>Projeler <strong>2 yıl parça garantili</strong>. İstanbul ekibi yerinde veya uzaktan müdahale eder; yedek parça stoğu tutulur.</p>\r\n    </details>\r\n  </div>\r\n\r\n  <div class=\"la-cta-box\">\r\n    <h2 class=\"la-gradient-title\">Projenizi hayata geçirelim</h2>\r\n    <p>Ölçü, pitch ve kullanım alanını yazın; <strong>LED ekran</strong> teklifini hazırlayalım.</p>\r\n    <a class=\"la-btn la-btn-primary\" href=\"https://ledajans.com/iletisim/\">Bize ulaşın</a>\r\n  </div>\r\n</div>\r\n\r\n<script type=\"application/ld+json\">\r\n{\r\n  \"@context\": \"https://schema.org\",\r\n  \"@type\": \"FAQPage\",\r\n  \"mainEntity\": [\r\n    {\r\n      \"@type\": \"Question\",\r\n      \"name\": \"LED ekran m² fiyatları neye göre değişir?\",\r\n      \"acceptedAnswer\": {\r\n        \"@type\": \"Answer\",\r\n        \"text\": \"LED ekran fiyatları piksel aralığı, ekran boyutu, LED çip kalitesi ve kontrol sistemine göre değişir. En doğru fiyat için Ledajans ile iletişime geçin.\"\r\n      }\r\n    },\r\n    {\r\n      \"@type\": \"Question\",\r\n      \"name\": \"Piksel (P) değeri nedir, hangisini seçmeliyim?\",\r\n      \"acceptedAnswer\": {\r\n        \"@type\": \"Answer\",\r\n        \"text\": \"P değeri iki LED arasındaki milimetre mesafedir. Yakın izleme (2-5m) için P1.8–P2.5; orta mesafe (5-10m) için P3–P5; uzak mesafe (10m+) için P6–P10 tercih edilir.\"\r\n      }\r\n    },\r\n    {\r\n      \"@type\": \"Question\",\r\n      \"name\": \"Garanti ve teknik servis süreciniz nasıl?\",\r\n      \"acceptedAnswer\": {\r\n        \"@type\": \"Answer\",\r\n        \"text\": \"Tüm LED ekran projelerimiz 2 yıl tam parça garantilidir. İstanbul merkezli teknik servis yerinde veya uzaktan müdahale eder.\"\r\n      }\r\n    }\r\n  ]\r\n}\r\n</script>\r\n<script type=\"application/ld+json\">\r\n{\r\n  \"@context\": \"https://schema.org\",\r\n  \"@type\": \"ItemList\",\r\n  \"name\": \"LED Ekran Kategorileri\",\r\n  \"itemListElement\": [\r\n    {\"@type\":\"ListItem\",\"position\":1,\"name\":\"İç Mekan LED Ekran\",\"url\":\"https://ledajans.com/ic-mekan-led-ekran/\"},\r\n    {\"@type\":\"ListItem\",\"position\":2,\"name\":\"Dış Mekan LED Ekran\",\"url\":\"https://ledajans.com/dis-mekan-led-ekran/\"},\r\n    {\"@type\":\"ListItem\",\"position\":3,\"name\":\"Rental LED Ekran\",\"url\":\"https://ledajans.com/rental-ekran/\"},\r\n    {\"@type\":\"ListItem\",\"position\":4,\"name\":\"COB – Smart Screen\",\"url\":\"https://ledajans.com/cob-ekran/\"},\r\n    {\"@type\":\"ListItem\",\"position\":5,\"name\":\"İç Mekan RGB Panel\",\"url\":\"https://ledajans.com/ic-mekan-rgb-panel/\"},\r\n    {\"@type\":\"ListItem\",\"position\":6,\"name\":\"Dış Mekan RGB Panel\",\"url\":\"https://ledajans.com/dis-mekan-rgb-panel/\"}\r\n  ]\r\n}\r\n</script>\r\n",
