       "html": "<!-- LEDAJANS Blog - Sayfa Üstü Hero/Banner - Teknik Destek Videoları -->\n<style>\n    .ledajans-blog-hero {\n      position: relative;\n      height: 200px;\n      background-image: url('https://ledajans.com/wp-content/uploads/2026/04/teknik-destek-scaled.png');\n      background-size: center ;\n      background-position: center 50%;\n      background-repeat: no-repeat;\n    }\n    @media (min-width: 640px) { .ledajans-blog-hero { height: 250px; } }\n    @media (min-width: 768px) { .ledajans-blog-hero { height: 300px; } }\n    .ledajans-blog-hero-overlay {\n      position: absolute;\n      inset: 0;\n      background: linear-gradient(135deg, rgba(26, 26, 46, 0.85), rgba(22, 33, 62, 0.8));\n      transition: background-color 0.3s;\n    }\n    .ledajans-blog-hero-inner {\n      position: relative;\n      height: 100%;\n      max-width: 80rem;\n      margin: 0 auto;\n      padding: 0 1rem;\n      display: flex;\n      align-items: center;\n    }\n    @media (min-width: 640px) { .ledajans-blog-hero-inner { padding: 0 1.5rem; } }\n    @media (min-width: 1024px) { .ledajans-blog-hero-inner { padding: 0 2rem; } }\n    .ledajans-blog-hero-content {\n      font-family: ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, \"Segoe UI\", Roboto, \"Helvetica Neue\", Arial, sans-serif;\n    }\n    .ledajans-blog-hero-title {\n      font-size: 2rem;\n      font-weight: 700;\n      color: #ffffff;\n      margin: 0;\n      letter-spacing: -0.025em;\n      line-height: 1.2;\n    }\n    @media (min-width: 640px) { .ledajans-blog-hero-title { font-size: 2.5rem; } }\n    @media (min-width: 768px) { .ledajans-blog-hero-title { font-size: 3rem; } }\n    .ledajans-blog-hero-subtitle {\n      display: block;\n      margin-top: 0.5rem;\n      font-size: 0.875rem;\n      font-weight: 400;\n      color: #d1d5db;\n      letter-spacing: -0.01em;\n      line-height: 1.5;\n    }\n    @media (min-width: 640px) { .ledajans-blog-hero-subtitle { font-size: 1rem; } }\n    @media (min-width: 768px) { .ledajans-blog-hero-subtitle { font-size: 1.125rem; } }\n    </style>\n    \n    <div class=\"ledajans-blog-hero\" role=\"img\" aria-label=\"Teknik destek videoları\">\n      <div class=\"ledajans-blog-hero-overlay\"></div>\n      <div class=\"ledajans-blog-hero-inner\">\n        <div class=\"ledajans-blog-hero-content\">\n          <h1 class=\"ledajans-blog-hero-title\">Teknik Destek Videoları</h1>\n          <span class=\"ledajans-blog-hero-subtitle\" style=\"color:#f46f2c\">LED ekran kurulum, kontrol kartı ayarlama ve yazılım kullanım rehberleri; Huidu, Colorlight ve Novastar teknik destek videoları.</span>\n        </div>\n      </div>\n    </div>\n\n<script type=\"application/ld+json\">\n{\n  \"@context\": \"https://schema.org\",\n  \"@type\": \"BreadcrumbList\",\n  \"itemListElement\": [\n    {\"@type\":\"ListItem\",\"position\":1,\"name\":\"Anasayfa\",\"item\":\"https://ledajans.com/\"},\n    {\"@type\":\"ListItem\",\"position\":2,\"name\":\"Teknik Destek\",\"item\":\"https://ledajans.com/teknik-destek-videolari/\"},\n    {\"@type\":\"ListItem\",\"position\":3,\"name\":\"Teknik Destek Videoları\",\"item\":\"https://ledajans.com/teknik-destek-videolari/\"}\n  ]\n}\n</script>"
      },
