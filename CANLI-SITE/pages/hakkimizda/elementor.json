       "html": "<!-- LEDAJANS Satış Kanallarımız - WordPress HTML Widget -->\n<style>\n    .ledajans-channels {\n      max-width: 1280px;\n      margin: 0 auto;\n      padding: 1.5rem 0.75rem;\n      margin-bottom: 8rem;\n    }\n    @media (min-width: 480px) {\n      .ledajans-channels {\n        padding: 2rem 1rem;\n      }\n    }\n    @media (min-width: 640px) {\n      .ledajans-channels {\n        padding: 4rem 1.5rem;\n      }\n    }\n    @media (min-width: 1024px) {\n      .ledajans-channels {\n        padding: 5rem 2rem;\n      }\n    }\n    \n    .ledajans-channels-title {\n      font-size: 2rem;\n      font-weight: 700;\n      color: #111827;\n      margin-bottom: 4rem;\n      text-align: center;\n      letter-spacing: -0.025em;\n    }\n    @media (min-width: 640px) {\n      .ledajans-channels-title {\n        font-size: 2.5rem;\n        margin-bottom: 4rem;\n      }\n    }\n    @media (min-width: 768px) {\n      .ledajans-channels-title {\n        font-size: 3rem;\n        margin-bottom: 4rem;\n      }\n    }\n    \n    .ledajans-channels-grid {\n      display: grid;\n      gap: 2rem;\n      grid-template-columns: 1fr;\n    }\n    @media (min-width: 768px) {\n      .ledajans-channels-grid {\n        grid-template-columns: repeat(3, 1fr);\n        gap: 2rem;\n      }\n    }\n    \n    .ledajans-channel-card {\n      background: white;\n      padding: 2rem;\n      border-radius: 1rem;\n      box-shadow: 0 10px 15px -3px rgba(0, 0, 0, 0.1), 0 4px 6px -2px rgba(0, 0, 0, 0.05);\n      transition: all 0.5s;\n      text-align: center;\n      display: flex;\n      flex-direction: column;\n      align-items: center;\n      justify-content: center;\n      min-height: 200px;\n      text-decoration: none;\n      cursor: pointer;\n      -webkit-tap-highlight-color: transparent;\n    }\n    .ledajans-channel-card:hover {\n      box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.25);\n      transform: translateY(-8px);\n    }\n    \n    .ledajans-channel-card-ledarabul {\n      order: 1;\n    }\n    @media (min-width: 768px) {\n      .ledajans-channel-card-ledarabul {\n        order: 2;\n      }\n    }\n    \n    .ledajans-channel-card-kacmasa {\n      order: 2;\n    }\n    @media (min-width: 768px) {\n      .ledajans-channel-card-kacmasa {\n        order: 1;\n      }\n    }\n    \n    .ledajans-channel-card-rental {\n      order: 3;\n    }\n    @media (min-width: 768px) {\n      .ledajans-channel-card-rental {\n        order: 3;\n      }\n    }\n    \n    .ledajans-channel-logo-wrapper {\n      width: 100%;\n      margin-bottom: 1rem;\n      display: flex;\n      align-items: center;\n      justify-content: center;\n      flex-grow: 1;\n    }\n    \n    .ledajans-channel-logo {\n      width: 100%;\n      height: auto;\n      max-height: 128px;\n      object-fit: contain;\n      display: block;\n    }\n    \n    .ledajans-channel-name {\n      font-size: 1.25rem;\n      font-weight: 700;\n      color: #111827;\n      margin-top: 1rem;\n    }\n    </style>\n    \n    <div class=\"ledajans-channels\">\n      <h2 class=\"ledajans-channels-title\">Satış Kanallarımız</h2>\n      <div class=\"ledajans-channels-grid\">\n        <a\n          href=\"https://ledarabul.com\"\n          target=\"_blank\"\n          rel=\"noopener noreferrer\"\n          class=\"ledajans-channel-card ledajans-channel-card-ledarabul\"\n        >\n          <div class=\"ledajans-channel-logo-wrapper\">\n            <img\n              src=\"https://ledajans.com/wp-content/uploads/2022/12/ledarabul.png\"\n              alt=\"LedAraBul\"\n              class=\"ledajans-channel-logo\"\n              loading=\"lazy\"\n              onerror=\"this.style.display='none'; this.parentElement.innerHTML='<div style=\\'color:#9ca3af;font-size:0.875rem;\\'>Logo</div>';\"\n            />\n          </div>\n          <h3 class=\"ledajans-channel-name\">LedAraBul</h3>\n        </a>\n        <a\n          href=\"https://kacmasa.com\"\n          target=\"_blank\"\n          rel=\"noopener noreferrer\"\n          class=\"ledajans-channel-card ledajans-channel-card-kacmasa\"\n        >\n          <div class=\"ledajans-channel-logo-wrapper\">\n            <img\n              src=\"https://ledajans.com/wp-content/uploads/2022/12/kacmasa.png\"\n              alt=\"Kacmasa\"\n              class=\"ledajans-channel-logo\"\n              loading=\"lazy\"\n              onerror=\"this.style.display='none'; this.parentElement.innerHTML='<div style=\\'color:#9ca3af;font-size:0.875rem;\\'>Logo</div>';\"\n            />\n          </div>\n          <h3 class=\"ledajans-channel-name\">Kacmasa</h3>\n        </a>\n        <a\n          href=\"https://rentalekran.com\"\n          target=\"_blank\"\n          rel=\"noopener noreferrer\"\n          class=\"ledajans-channel-card ledajans-channel-card-rental\"\n        >\n          <div class=\"ledajans-channel-logo-wrapper\">\n            <img\n              src=\"https://ledajans.com/wp-content/uploads/2025/11/rental-ekran-logo-yatay-1.png\"\n              alt=\"Rental Ekran - Kiralanabilir LED Ekran Çözümleri\"\n              class=\"ledajans-channel-logo\"\n              loading=\"lazy\"\n              onerror=\"this.style.display='none'; this.parentElement.innerHTML='<div style=\\'color:#9ca3af;font-size:0.875rem;\\'>Logo</div>';\"\n            />\n          </div>\n          <h3 class=\"ledajans-channel-name\">Rental Ekran</h3>\n        </a>\n      </div>\n    </div>"
      },
