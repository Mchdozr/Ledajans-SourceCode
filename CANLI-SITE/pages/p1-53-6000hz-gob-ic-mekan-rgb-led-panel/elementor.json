ble tbody td:first-child { font-size: 0.75rem; font-weight: 600; text-transform: uppercase; color: #4b5563; }\n  .la-highlight-row { border-color: rgba(244, 111, 44, 0.35) !important; background: rgba(244, 111, 44, 0.06) !important; }\n  .la-highlight-row td:last-child { color: #f46f2c !important; font-weight: 700; }\n}\n@media (min-width: 768px) { .la-spec-table { min-width: 480px; } }\n.la-spec-table { width: 100%; border-collapse: collapse; font-size: 0.9rem; }\n.la-spec-table thead th { background: #1a1a2e; color: #fff; font-weight: 600; text-align: left; padding: 0.85rem 1rem; font-size: 0.85rem; text-transform: uppercase; }\n.la-spec-table tbody td { padding: 0.7rem 1rem; border-bottom: 1px solid #e5e7eb; }\n.la-spec-table tbody tr:nth-child(even) { background: #f9fafb; }\n.la-spec-table tbody tr:hover { background: #fef3eb; }\n.la-spec-table tbody td:first-child { font-weight: 600; color: #1a1a2e; min-width: 200px; }\n.la-spec-table tbody td:last-child { color: #374151; }\n.la-highlight-row td { background: rgba(244, 111, 44, 0.08) !important; }\n.la-highlight-row td:last-child { color: #f46f2c !important; font-weight: 700; }\n.la-doc-download { display: inline-flex; align-items: center; gap: 0.5rem; background: linear-gradient(135deg, #f46f2c, #e05a1e); color: #fff; text-decoration: none; padding: 0.75rem 1.5rem; border-radius: 8px; font-weight: 600; font-size: 0.9rem; margin: 0.5rem 0.5rem 0.5rem 0; }\n.la-doc-download:hover { transform: translateY(-2px); box-shadow: 0 4px 12px rgba(244, 111, 44, 0.35); color: #fff; }\n.la-doc-download--secondary { background: linear-gradient(135deg, #1a1a2e, #16213e); }\n.la-features-grid { display: grid; grid-template-columns: 1fr; gap: 1rem; margin: 1.5rem 0 2rem; }\n@media (min-width: 640px) { .la-features-grid { grid-template-columns: 1fr 1fr; } }\n@media (min-width: 1024px) { .la-features-grid { grid-template-columns: 1fr 1fr 1fr; } }\n.la-feature-card { background: #fff; border: 1px solid #e5e7eb; border-radius: 10px; padding: 1.25rem; }\n.la-feature-card:hover { border-color: #f46f2c; box-shadow: 0 4px 12px rgba(244, 111, 44, 0.12); }\n.la-feature-card strong { display: block; color: #1a1a2e; font-size: 0.95rem; margin-bottom: 0.35rem; }\n.la-feature-card span { color: #6b7280; font-size: 0.85rem; line-height: 1.5; }\n.la-breadcrumb { font-size: 0.85rem; color: #6b7280; margin-bottom: 1.5rem; }\n.la-breadcrumb a { color: #f46f2c; text-decoration: none; }\n.la-breadcrumb span { margin: 0 0.35rem; color: #9ca3af; }\n.la-cta-section { background: linear-gradient(135deg, #1a1a2e 0%, #16213e 100%); border-radius: 12px; padding: 2rem 1.5rem; margin-top: 2.5rem; text-align: center; }\n.la-cta-section h3 { color: #fff; font-size: 1.35rem; margin: 0 0 0.5rem 0; }\n.la-cta-section p { color: #d1d5db; margin: 0 0 1.25rem 0; }\n.la-cta-section a { display: inline-flex; align-items: center; gap: 0.4rem; background: #f46f2c; color: #fff; text-decoration: none; padding: 0.7rem 1.5rem; border-radius: 8px; font-weight: 600; font-size: 0.9rem; margin: 0.25rem; }\n.la-cta-section a:hover { background: #e05a1e; }\n.la-seo-text { margin-top: 2rem; padding: 1.5rem; background: #f8f9fa; border-radius: 10px; }\n.la-seo-text h3 { margin-top: 0; }\n</style>\n<div class=\"la-product-detail\">\n<nav class=\"la-breadcrumb\">\n<a href=\"https://ledajans.com\">Ana Sayfa</a><span>›</span>\n<a href=\"https://ledajans.com/led-ekran/\">Ürünlerimiz</a><span>›</span>\n<a href=\"https://ledajans.com/ic-mekan-rgb-panel/\">İç Mekan RGB Panel</a><span>›</span>\n    P1.53 GOB İç Mekan RGB Panel\n  </nav>\n<div class=\"la-product-intro\">\n<h2>P1.53 GOB İç Mekan RGB Panel</h2>\n<p><strong>P1.53 GOB LED panel</strong>, GOB kapsüllemeli <strong>1.53mm piksel aralığına</strong> sahip iç mekan RGB paneldir. SMD1212 RGB tam renk ile <strong>422.500 piksel/m²</strong> yoğunluk, ≥6000Hz yenileme ve IP65 koruma sunar. HUB75 arayüzü ile kurulumu kolaydır.</p>\n</div>\n<div class=\"la-product-badges\">\n<span class=\"la-product-badge la-product-badge--orange\">GOB</span>\n<span class=\"la-product-badge\">1.53 mm</span>\n<span class=\"la-product-badge la-product-badge--orange\">≥6000Hz</span>\n<span class=\"la-product-badge\">422.500 piksel/m²</span>\n<span class=\"la-product-badge la-product-badge--orange\">14bit</span>\n<span class=\"la-product-badge\">IP65</span>\n</div>\n<div class=\"la-features-grid\">\n<div class=\"la-feature-card\"><strong>GOB Kapsülleme</strong><span>Epoksi + VMD vakum kapsülleme ile dayanıklılık.</span></div>\n<div class=\"la-feature-card\"><strong>Orta Yoğunluk</strong><span>1.53mm ile 422.500 piksel/m² – dengeli çözünürlük ve maliyet.</span></div>\n<div class=\"la-feature-card\"><strong>Yüksek Yenileme</strong><span>≥6000Hz ile kamera uyumlu görüntü.</span></div>\n<div class=\"la-feature-card\"><strong>SMD1212</strong><span>RGB tam renk, 208×104 modül çözünürlüğü.</span></div>\n<div class=\"la-feature-card\"><strong>Düşük Güç</strong><span>Ortalama 10.3W/modül, 224W/m².</span></div>\n<div class=\"la-feature-card\"><strong>Ön Bakım</strong><span>320×160×17mm, 532±10g – kolay montaj.</span></div>\n</div>\n<div class=\"la-spec-header\">\n<h2>P1.53 GOB Teknik Özellikler</h2>\n<a class=\"la-doc-download\" href=\"https://drive.google.com/uc?export=download&amp;id=1XyGMx-_EtFHhiqayQizPpDh7U32S1psL\" rel=\"noopener\" target=\"_blank\">P1.53 GOB Dokümantasyonu İndir (PDF)</a>\n<a class=\"la-doc-download la-doc-download--secondary\" href=\"https://ledajans.com/wp-content/uploads/2024/09/Indoor-modules.zip\">DWG İndir</a>\n</div>\n<div class=\"la-spec-table-wrapper\">\n<table class=\"la-spec-table\">\n<thead><tr><th>Parametre</th><th>Özellik</th></tr></thead>\n<tbody>\n<tr class=\"la-highlight-row\"><td>Pikselleme aralığı</td><td>1.53mm</td></tr>\n<tr class=\"la-highlight-row\"><td>Pixel Yoğunluğu</td><td>422.500 piksel/m²</td></tr>\n<tr><td>Pikselleme konfigürasyonu</td><td>SMD1212 RGB Tam Renk</td></tr>\n<tr><td>LED türü</td><td>SMD1212</td></tr>\n<tr><td>Modül boyutu</td><td>G320 × Y160 × D17mm</td></tr>\n<tr><td>Modül ağırlığı</td><td>532±10g</td></tr>\n<tr><td>Modül çözünürlüğü</td><td>208×104</td></tr>\n<tr><td>Güç besleme voltajı</td><td>AC100-240V, 50/60Hz</td></tr>\n<tr><td>Parlaklık</td><td>≥500cd/m²</td></tr>\n<tr><td>Kontrast Oranı</td><td>5000:1</td></tr>\n<tr><td>Renk Sıcaklığı</td><td>3000~21000K</td></tr>\n<tr><td>Görüntü Açısı</td><td>H≥160° V≥140°</td></tr>\n<tr><td>Parlaklık Uniformitesi</td><td>≥97%</td></tr>\n<tr><td>Renk Uniformitesi</td><td>≤±0.003 Cx, Cy</td></tr>\n<tr><td>Giriş Voltajı</td><td>4.5~5V</td></tr>\n<tr><td>Maks. Akım</td><td>6.2A</td></tr>\n<tr><td>Ortalama Güç Tüketimi</td><td>10.3W Parça başına / 224W/m²</td></tr>\n<tr><td>Maks. Güç Tüketimi</td><td>31W Parça başına / 673W/m²</td></tr>\n<tr class=\"la-highlight-row\"><td>Yenileme Hızı</td><td>≥6000Hz</td></tr>\n<tr><td>Kare Hızı</td><td>50~60Hz</td></tr>\n<tr><td>Sürüş Modu</td><td>1/52 tarama</td></tr>\n<tr><td>Sinyal İşleme Derinliği</td><td>14bit (16384 gri tonlama)</td></tr>\n<tr><td>Sinyal Arayüzü</td><td>HUB75×1pcs</td></tr>\n<tr><td>Güç Arayüzü</td><td>VH4P×1pcs</td></tr>\n<tr><td>Çalışma Sıcaklığı</td><td>-20°C~+40°C</td></tr>\n<tr><td>Çalışma Nem Oranı</td><td>10%~60% RH (Yoğuşmasız)</td></tr>\n<tr><td>Depolama Sıcaklığı</td><td>-20°C~+60°C</td></tr>\n<tr><td>Depolama Nem Oranı</td><td>10%~60% RH (Yoğuşmasız)</td></tr>\n<tr><td>Koruma Sınıfı</td><td>IP65</td></tr>\n<tr><td>PCB Alev Dayanıklılık</td><td>UL94 V-0</td></tr>\n<tr><td>MTBF</td><td>≥5000 saat</td></tr>\n<tr><td>Bakım Modu</td><td>Ön Bakım</td></tr>\n<tr><td>Yere Kaçak Akım</td><td>≤3.5mA/m²</td></tr>\n<tr><td>Piksel Kontrol Dışı Oranı</td><td>≤1/10000</td></tr>\n<tr><td>GOB Kapsülleme</td><td>Epoksi Reçine + VMD Vakum Kapsülleme</td></tr>\n<tr><td>Yükleme Kapasitesi</td><td>MAX5pcs@5V 40A / MAX10pcs@5V 80A</td></tr>\n</tbody>\n</table>\n</div>\n<div class=\"la-seo-text\">\n<h3>P1.53 GOB LED Panel Nedir?</h3>\n<p><strong>P1.53 GOB LED panel</strong>, 1.53mm piksel aralığına sahip GOB kapsüllemeli iç mekan RGB modüldür. 422.500 piksel/m² ve ≥6000Hz yenileme ile kurumsal ve reklam ekranı projelerinde kullanılır.</p>\n<h3>P1.53 GOB Kullanım Alanları</h3>\n<p>Toplantı salonları, showroom, mağaza içi ekranlar, kontrol odaları ve iç mekan reklam ekranları için uygundur.</p>\n<h3>P1.53 GOB Avantajları</h3>\n<p>GOB kapsülleme, 1/52 tarama ve 14bit gri tonlama ile yüksek görüntü kalitesi ve dayanıklılık sunar.</p>\n</div>\n<div class=\"la-cta-section\">\n<h3>P1.53 GOB LED Panel Fiyat Teklifi</h3>\n<p>Projeniz için P1.53 GOB iç mekan RGB panel teklifi alın.</p>\n<a href=\"tel:+902122204004\">+90 212 220 40 04</a>\n<a href=\"tel:+905438795108\">+90 543 879 51 08</a>\n<a href=\"mailto:info@ledajans.com\">info@ledajans.com</a>\n</div>\n</div>"
