       "html": "<!-- LEDAJANS SEO - Smart Screen LED Ekran - Ürün Detay İçerik -->\n<style>\n.la-product-detail{\n  font-family:ui-sans-serif,system-ui,-apple-system,BlinkMacSystemFont,\"Segoe UI\",Roboto,\"Helvetica Neue\",Arial,sans-serif;\n  max-width:80rem;margin:0 auto;padding:2rem 1rem;color:#1f2937;line-height:1.7;\n}\n@media (min-width:640px){.la-product-detail{padding:2.5rem 1.5rem;}}\n@media (min-width:1024px){.la-product-detail{padding:3rem 2rem;}}\n.la-product-detail h2{\n  font-size:1.75rem;font-weight:700;color:#1a1a2e;margin:0 0 1rem 0;\n  padding-bottom:.7rem;border-bottom:3px solid #f46f2c;display:inline-block;\n}\n@media (min-width:768px){.la-product-detail h2{font-size:2rem;}}\n.la-product-detail h3{font-size:1.2rem;font-weight:600;color:#16213e;margin:1.8rem 0 .7rem;}\n.la-product-intro{\n  background:linear-gradient(135deg,#f8f9fa 0%,#eef1f4 100%);\n  border-left:4px solid #f46f2c;border-radius:12px;padding:1.4rem;margin-bottom:1.8rem;\n}\n.la-product-badges{display:flex;flex-wrap:wrap;gap:.5rem;margin-bottom:1.8rem;}\n.la-product-badge{background:#1a1a2e;color:#fff;border-radius:20px;padding:.4rem .85rem;font-size:.8rem;font-weight:500;}\n.la-product-badge--orange{background:#f46f2c;}\n.la-features-grid{display:grid;grid-template-columns:1fr;gap:1rem;margin:1rem 0 2rem;}\n@media (min-width:640px){.la-features-grid{grid-template-columns:1fr 1fr;}}\n@media (min-width:1024px){.la-features-grid{grid-template-columns:1fr 1fr 1fr;}}\n.la-feature-card{background:#fff;border:1px solid #e5e7eb;border-radius:10px;padding:1.1rem;}\n.la-feature-card strong{display:block;color:#1a1a2e;font-size:.95rem;margin-bottom:.3rem;}\n.la-feature-card span{font-size:.85rem;color:#6b7280;line-height:1.5;}\n.la-spec-table-wrapper{margin:1.2rem 0;border-radius:10px;overflow:auto;box-shadow:0 1px 3px rgba(0,0,0,.1);}\n.la-spec-table{width:100%;border-collapse:collapse;font-size:.9rem;min-width:760px;}\n.la-spec-table thead th{background:#1a1a2e;color:#fff;text-align:left;padding:.85rem 1rem;font-size:.83rem;text-transform:uppercase;}\n.la-spec-table tbody td{padding:.72rem 1rem;border-bottom:1px solid #e5e7eb;vertical-align:top;}\n.la-spec-table tbody tr:nth-child(even){background:#f9fafb;}\n.la-spec-table tbody td:first-child{font-weight:600;color:#1a1a2e;min-width:240px;}\n.la-highlight-row td{background:rgba(244,111,44,.08)!important;font-weight:700!important;}\n.la-highlight-row td:first-child{color:#f46f2c!important;}\n.la-doc-download{\n  display:inline-flex;align-items:center;gap:.5rem;text-decoration:none;color:#fff;\n  background:linear-gradient(135deg,#f46f2c,#e05a1e);padding:.75rem 1.4rem;border-radius:8px;\n  font-size:.9rem;font-weight:600;margin:.2rem .5rem .8rem 0;\n}\n.la-breadcrumb{font-size:.85rem;color:#6b7280;margin-bottom:1.4rem;}\n.la-breadcrumb a{color:#f46f2c;text-decoration:none;}\n.la-breadcrumb span{margin:0 .35rem;color:#9ca3af;}\n.la-seo-text{margin-top:1.8rem;padding:1.4rem;background:#f8f9fa;border-radius:10px;}\n.la-cta-section{\n  background:linear-gradient(135deg,#1a1a2e 0%,#16213e 100%);\n  border-radius:12px;padding:1.8rem 1.2rem;margin-top:2.2rem;text-align:center;\n}\n.la-cta-section h3{color:#fff;margin:0 0 .5rem 0;font-size:1.3rem;}\n.la-cta-section p{color:#d1d5db;margin:0 0 1rem 0;}\n.la-cta-section a{\n  display:inline-flex;text-decoration:none;background:#f46f2c;color:#fff;border-radius:8px;\n  padding:.65rem 1.3rem;font-size:.9rem;font-weight:600;margin:.2rem;\n}\n</style>\n<div class=\"la-product-detail\">\n<nav class=\"la-breadcrumb\">\n<a href=\"https://ledajans.com\">Ana Sayfa</a><span>›</span>\n<a href=\"https://ledajans.com/led-ekran/\">Ürünlerimiz</a><span>›</span>\n<a href=\"https://ledajans.com/cob-smart-screen/\">COB - Smart Screen</a><span>›</span>\n    Smart Screen LED Ekran\n  </nav>\n<div class=\"la-product-intro\">\n<h2>Smart Screen LED Ekran</h2>\n<p><strong>Smart Screen LED Ekran</strong>, 108/136/163 inç all-in-one yapısı, 2K çözünürlük, Android 11 işletim sistemi ve ön bakım avantajıyla kurumsal toplantı, eğitim ve sunum alanları için tasarlanmıştır.</p>\n</div>\n<div class=\"la-product-badges\">\n<span class=\"la-product-badge la-product-badge--orange\">108 / 136 / 163 inç</span>\n<span class=\"la-product-badge\">2K Çözünürlük</span>\n<span class=\"la-product-badge la-product-badge--orange\">≥3840Hz</span>\n<span class=\"la-product-badge\">Android 11</span>\n<span class=\"la-product-badge la-product-badge--orange\">Ön Bakım</span>\n</div>\n<div class=\"la-features-grid\">\n<div class=\"la-feature-card\"><strong>All‑in‑One Kullanım</strong><span>Mobil veya duvar tipi kurulumla toplantı alanlarına hızlı entegrasyon.</span></div>\n<div class=\"la-feature-card\"><strong>2K Görüntü Kalitesi</strong><span>16:9 oranla kurumsal sunum, eğitim ve video içeriklerde net görüntü.</span></div>\n<div class=\"la-feature-card\"><strong>Yüksek Yenileme</strong><span>≥3840Hz ile akıcı görüntü ve kamera çekimine uyumlu yapı.</span></div>\n<div class=\"la-feature-card\"><strong>Android 11 Platformu</strong><span>Dahili sistemle kolay kontrol, Bluetooth kumanda ve Wi‑Fi desteği.</span></div>\n<div class=\"la-feature-card\"><strong>Geniş Görüş Açısı</strong><span>170°/170° açılarla salonun farklı noktalarından rahat izleme.</span></div>\n<div class=\"la-feature-card\"><strong>Opsiyonel Toplantı Donanımı</strong><span>Dokunmatik, kamera, konferans terminali ve OPS seçenekleri.</span></div>\n</div>\n<a class=\"la-doc-download\" href=\"https://drive.google.com/uc?export=download&amp;id=1P8mvuPT_ZEbHqZ2igsjZE1gNM6z-qpj6\" rel=\"noopener noreferrer\" target=\"_blank\">Smart Screen Dökümanını İndir</a>\n<div class=\"la-spec-table-wrapper\">\n<table class=\"la-spec-table\">\n<thead>\n<tr><th>Parametre</th><th>108</th><th>136</th><th>163</th></tr>\n</thead>\n<tbody>\n<tr class=\"la-highlight-row\"><td>Görüntü Çözünürlüğü</td><td>2K</td><td>2K</td><td>2K</td></tr>\n<tr><td>Ekran Boyutu (inç)</td><td>108</td><td>136</td><td>163</td></tr>\n<tr><td>Görüntü Oranı</td><td>16:9</td><td>16:9</td><td>16:9</td></tr>\n<tr><td>Panel Teknolojisi</td><td>SMD GOB</td><td>SMD GOB</td><td>SMD GOB</td></tr>\n<tr><td>Piksel Aralığı</td><td>1.25 mm</td><td>1.5625 mm</td><td>1.875 mm</td></tr>\n<tr class=\"la-highlight-row\"><td>Yenileme Frekansı</td><td>≥3840 Hz</td><td>≥3840 Hz</td><td>≥3840 Hz</td></tr>\n<tr><td>Parlaklık</td><td>≥500 nit</td><td>≥500 nit</td><td>≥500 nit</td></tr>\n<tr><td>Kontrast</td><td>≥5000:1</td><td>≥5000:1</td><td>≥5000:1</td></tr>\n<tr><td>Görüş Açısı</td><td>170°/170°</td><td>170°/170°</td><td>170°/170°</td></tr>\n<tr><td>Tepe Güç Tüketimi</td><td>2000W</td><td>2500W</td><td>3600W</td></tr>\n<tr><td>Ekran Boyutu (mm)</td><td>2400×1350</td><td>3000×1687.5</td><td>3600×2025</td></tr>\n<tr><td>Ekran Kalınlığı</td><td>33.5 mm</td><td>33.5 mm</td><td>33.5 mm</td></tr>\n<tr><td>İşletim Sistemi</td><td>Android 11</td><td>Android 11</td><td>Android 11</td></tr>\n<tr><td>Wi‑Fi</td><td>2.4G / 5G</td><td>2.4G / 5G</td><td>2.4G / 5G</td></tr>\n<tr><td>Bluetooth</td><td>BT5.0</td><td>BT5.0</td><td>BT5.0</td></tr>\n<tr><td>Bakım</td><td>Ön Bakım</td><td>Ön Bakım</td><td>Ön Bakım</td></tr>\n</tbody>\n</table>\n</div>\n<div class=\"la-seo-text\">\n<h3>Smart Screen LED Ekran Nerede Kullanılır?</h3>\n<p>Toplantı odaları, yönetim salonları, eğitim sınıfları, showroomlar ve kurumsal sunum alanlarında kullanılır.</p>\n<h3>Neden Smart Screen?</h3>\n<p>All‑in‑one kurulum, dahili Android altyapısı, yüksek yenileme hızı ve opsiyonel toplantı ekipmanlarıyla modern kurumsal kullanım için güçlü bir çözümdür.</p>\n</div>\n<div class=\"la-cta-section\">\n<h3>Smart Screen LED Ekran Fiyat Teklifi Alın</h3>\n<p>Projenize uygun ekran ölçüsü ve teknik yapı için bizimle iletişime geçin.</p>\n<a href=\"tel:+902122204004\">+90 212 220 40 04</a>\n<a href=\"tel:+905438795108\">+90 543 879 51 08</a>\n<a href=\"mailto:info@ledajans.com\">info@ledajans.com</a>\n</div>\n</div>"
