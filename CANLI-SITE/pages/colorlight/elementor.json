     {
      "id": "d40fa72",
      "elType": "widget",
      "widgetType": "html",
      "settings": {
       "html": "<!-- LEDAJANS - COLORLIGHT PLAYMASTER TR SAYFASI (3'lü hero: PlayMaster + Manual + Ledsettings) — DOCTYPE/html/body YOK -->\n<style>\n    .la-pmtr-page{\n      font-family: ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, \"Segoe UI\", Roboto, \"Helvetica Neue\", Arial, sans-serif;\n      max-width: 80rem;\n      margin: 0 auto;\n      padding: 2rem 1rem 3rem;\n      color: #1f2937;\n    }\n    @media (min-width:1024px){ .la-pmtr-page{ padding: 2.5rem 2rem 3.5rem; } }\n    \n    .la-pmtr-breadcrumb{\n      margin:1rem 0 1.5rem;\n      font-size:.85rem;\n      color:#6b7280;\n    }\n    .la-pmtr-breadcrumb a{ color:#f46f2c; text-decoration:none; }\n    .la-pmtr-breadcrumb span{ margin:0 .35rem; color:#9ca3af; }\n    \n    .la-pmtr-badge{\n      display:inline-flex; align-items:center;\n      background: rgba(244,111,44,.14);\n      color:#ffd7c3;\n      border:1px solid rgba(244,111,44,.45);\n      padding:.35rem .7rem;\n      border-radius:999px;\n      font-size:.78rem;\n      font-weight:700;\n      letter-spacing:.02em;\n    }\n    \n    /* 3'lü hero grid */\n    .la-pmtr-hero-grid{\n      display:grid;\n      grid-template-columns:1fr;\n      gap:1rem;\n    }\n    @media (min-width:992px){ .la-pmtr-hero-grid{ grid-template-columns:1fr 1fr 1fr; } }\n    \n    .la-pmtr-hero-card{\n      position: relative;\n      border-radius: 18px;\n      overflow: hidden;\n      min-height: 300px;\n      background: #0f172a;\n      box-shadow: 0 18px 40px rgba(15, 23, 42, .20);\n    }\n    .la-pmtr-hero-card-bg{\n      position:absolute; inset:0;\n      background-size: cover;\n      background-position: center;\n    }\n    .la-pmtr-hero-card-bg--playmaster{\n      background-image:\n        linear-gradient(120deg, rgba(15,23,42,.82), rgba(15,23,42,.55)),\n        url(\"https://ledajans.com/wp-content/uploads/2025/11/05-超高画质极致享受2_1742954006.png\");\n    }\n    .la-pmtr-hero-card-bg--manual{\n      background-image:\n        linear-gradient(120deg, rgba(15,23,42,.84), rgba(15,23,42,.58)),\n        url(\"https://ledajans.com/wp-content/uploads/2025/11/13-Web控制简易配屏2_1742955230-e1763454690539.png\");\n    }\n    .la-pmtr-hero-card-bg--ledsettings{\n      background-image:\n        linear-gradient(120deg, rgba(15,23,42,.84), rgba(15,23,42,.58)),\n        url(\"https://ledajans.com/wp-content/uploads/2025/11/11-预监回显形式丰富2_1742955187-e1763458137562.png\");\n    }\n    .la-pmtr-hero-card-content{\n      position: relative;\n      z-index: 1;\n      padding: 2rem 1.2rem;\n    }\n    @media (min-width:768px){ .la-pmtr-hero-card-content{ padding: 2.4rem 1.6rem; } }\n    \n    .la-pmtr-title{\n      margin:.8rem 0 .6rem;\n      color:#fff;\n      font-size: clamp(1.25rem, 2.8vw, 2rem);\n      font-weight:800;\n      line-height:1.15;\n      letter-spacing:-.02em;\n    }\n  .la-pmtr-subtitle{\n    margin:0;\n    color:#dbe4f0;\n    font-size: clamp(.85rem, 1.6vw, 1rem);\n    line-height:1.68;\n    max-width: 56rem;\n    }\n    /* Hero içi metin linki: turuncu → hover beyaz */\n    a.la-pmtr-hero-textlink {\n      color: #f46f2c !important;\n      text-decoration: none;\n      font-weight: 600;\n      transition: color 0.2s ease;\n    }\n    a.la-pmtr-hero-textlink:hover {\n      color: #ffffff !important;\n    }\n    .la-pmtr-actions{\n      margin-top:1.1rem;\n      display:flex;\n      flex-wrap:wrap;\n      gap:.65rem;\n    }\n    .la-pmtr-btn{\n      text-decoration:none;\n      display:inline-flex; align-items:center; gap:.45rem;\n      padding:.72rem 1rem;\n      border-radius:10px;\n      font-size:.88rem;\n      font-weight:700;\n      transition:.2s ease;\n    }\n    .la-pmtr-btn--primary{\n      background:#f46f2c;\n      color:#fff !important;\n    }\n    .la-pmtr-btn--primary:hover{ background:#e35f1d; color:#fff; transform: translateY(-1px); }\n    .la-pmtr-btn--secondary{\n      background:rgba(255,255,255,.12);\n      color:#fff !important;\n      border:1px solid rgba(255,255,255,.25);\n    }\n    .la-pmtr-btn--secondary:hover{ background:rgba(255,255,255,.2); color:#fff; }\n    \n    .la-pmtr-section-title{\n      margin: 2rem 0 .8rem;\n      font-size: clamp(1.3rem,2.3vw,1.75rem);\n      font-weight:800;\n      color:#1a1a2e;\n      line-height:1.2;\n    }\n    .la-pmtr-section-title::after{\n      content:\"\";\n      display:block;\n      width:46px; height:4px;\n      margin-top:.5rem;\n      background:#f46f2c;\n      border-radius:999px;\n    }\n    \n    .la-pmtr-grid{\n      display:grid;\n      grid-template-columns:1fr;\n      gap:1rem;\n    }\n    @media (min-width:768px){ .la-pmtr-grid{ grid-template-columns:repeat(3,1fr); } }\n    \n    .la-pmtr-card{\n      border:1px solid #e5e7eb;\n      border-radius:14px;\n      background:#fff;\n      overflow:hidden;\n      box-shadow:0 6px 18px rgba(15,23,42,.05);\n    }\n    .la-pmtr-card img{\n      width:100%;\n      aspect-ratio:16/9;\n      object-fit:cover;\n      display:block;\n    }\n    .la-pmtr-card-body{ padding:.95rem 1rem 1rem; }\n    .la-pmtr-card h3{\n      margin:.05rem 0 .35rem;\n      font-size:1.02rem;\n      line-height:1.35;\n      color:#1a1a2e;\n    }\n    .la-pmtr-card p{\n      margin:0;\n      color:#4b5563;\n      font-size:.9rem;\n      line-height:1.6;\n    }\n    \n    .la-pmtr-downloads{\n      margin-top:1rem;\n      display:grid;\n      grid-template-columns:1fr;\n      gap:.8rem;\n    }\n    @media (min-width:768px){ .la-pmtr-downloads{ grid-template-columns:repeat(3,1fr); } }\n    \n    .la-pmtr-dl{\n      border:1px solid #e5e7eb;\n      border-radius:12px;\n      background:linear-gradient(180deg,#ffffff,#fafafa);\n      padding:1rem;\n    }\n    .la-pmtr-dl-title{\n      margin:0 0 .4rem;\n      font-size:1rem;\n      color:#1a1a2e;\n      font-weight:700;\n    }\n    .la-pmtr-dl-desc{\n      margin:0 0 .75rem;\n      font-size:.9rem;\n      color:#6b7280;\n      line-height:1.55;\n    }\n    .la-pmtr-dl a{\n      text-decoration:none;\n      display:inline-flex; align-items:center; gap:.45rem;\n      background:#f46f2c;\n      color:#fff;\n      padding:.62rem .95rem;\n      border-radius:9px;\n      font-size:.85rem;\n      font-weight:700;\n    }\n    .la-pmtr-dl a:hover{ background:#e35f1d; color:#fff; }\n    \n    .la-pmtr-seo{\n      margin-top:1.2rem;\n      border:1px solid #e5e7eb;\n      border-radius:12px;\n      padding:1rem;\n      background:#f9fafb;\n    }\n    .la-pmtr-seo p{\n      margin:.2rem 0;\n      color:#374151;\n      font-size:.93rem;\n      line-height:1.7;\n    }\n    </style>\n    \n    <div class=\"la-pmtr-page\">\n    \n      <nav class=\"la-pmtr-breadcrumb\" aria-label=\"Sayfa konumu\">\n        <a href=\"https://ledajans.com\">Ana Sayfa</a><span>›</span>\n        <a href=\"https://ledajans.com/teknik-destek-bilgi/\">Teknik Destek & Bilgi</a><span>›</span>\n        Colorlight PlayMaster TR\n      </nav>\n    \n      <!-- 3'lü hero -->\n      <div class=\"la-pmtr-hero-grid\">\n        <section class=\"la-pmtr-hero-card\">\n          <div class=\"la-pmtr-hero-card-bg la-pmtr-hero-card-bg--playmaster\" role=\"img\" aria-label=\"PlayMaster arka plan\"></div>\n          <div class=\"la-pmtr-hero-card-content\">\n            <span class=\"la-pmtr-badge\">COLORLIGHT YAZILIM DESTEĞİ</span>\n            <h2 class=\"la-pmtr-title\">Colorlight PlayMaster TR İndir</h2>\n            <p class=\"la-pmtr-subtitle\">\n              LED ekran kurulum, tarama ve yayın yönetimi için güncel <strong>Colorlight PlayMaster TR</strong> dosyaları.\n              İçerikte kurulum yazılımı ve Türkçe kullanıcı kılavuzu birlikte sunulmuştur.\n            </p>\n            <div class=\"la-pmtr-actions\">\n              <a\n                class=\"la-pmtr-btn la-pmtr-btn--primary\"\n                href=\"https://drive.google.com/uc?export=download&id=1sDr9PZhZX1BdOgp78c5tPs32phQoetUe\"\n                target=\"_blank\"\n                rel=\"noopener noreferrer\">\n                PlayMaster TR İndir\n              </a>\n            </div>\n          </div>\n        </section>\n    \n        <section class=\"la-pmtr-hero-card\">\n          <div class=\"la-pmtr-hero-card-bg la-pmtr-hero-card-bg--manual\" role=\"img\" aria-label=\"Kullanım kılavuzu arka plan\"></div>\n          <div class=\"la-pmtr-hero-card-content\">\n            <span class=\"la-pmtr-badge\">KULLANIM KILAVUZU</span>\n            <h2 class=\"la-pmtr-title\">PLAYMASTER User Manual V1.4 TR</h2>\n            <p class=\"la-pmtr-subtitle\">\n              Kurulum adımları, tarama ayarları ve kullanım detayları için güncel Türkçe kullanıcı kılavuzunu doğrudan indirebilirsiniz. Ledajans olarak ihtiyacınız olan her şeye sahibiz.\n            </p>\n            <div class=\"la-pmtr-actions\">\n              <a\n                class=\"la-pmtr-btn la-pmtr-btn--secondary\"\n                href=\"https://ledajans.com/wp-content/uploads/2025/03/PlayerMaster-User-Manual-V1.4-TR.pdf\"\n                download=\"PlayerMaster-User-Manual-V1.4-TR.pdf\">\n                User Manual V1.4 TR İndir\n              </a>\n            </div>\n          </div>\n        </section>\n    \n        <section class=\"la-pmtr-hero-card\">\n          <div class=\"la-pmtr-hero-card-bg la-pmtr-hero-card-bg--ledsettings\" role=\"img\" aria-label=\"Ledsettings arka plan\"></div>\n          <div class=\"la-pmtr-hero-card-content\">\n            <span class=\"la-pmtr-badge\">COLORLIGHT YAZILIM DESTEĞİ</span>\n            <h2 class=\"la-pmtr-title\">Colorlight - Ledsettings İndir</h2>\n            <p class=\"la-pmtr-subtitle\">\n              LED ekran yapılandırma ve ayar yönetimi için güncel <strong>Ledsettings</strong> paketini tek tıkla indirebilirsiniz. Sizin için güncel indirme bağlantı ve dosyaları <a class=\"la-pmtr-hero-textlink\" href=\"https://ledajans.com/program-indir/\">Teknik Destek sayfamızda</a> mevcut. \n            </p>\n            <div class=\"la-pmtr-actions\">\n              <a\n                class=\"la-pmtr-btn la-pmtr-btn--primary\"\n                href=\"https://drive.google.com/uc?export=download&id=1tfHaa5BL_iddhBFzyMCsYUXf04nPgJPD\"\n                target=\"_blank\"\n                rel=\"noopener noreferrer\">\n                Ledsettings V2.2 İndir\n              </a>\n            </div>\n          </div>\n        </section>\n      </div>\n    \n      <h2 class=\"la-pmtr-section-title\">Öne Çıkan Özellikler</h2>\n      <div class=\"la-pmtr-grid\">\n        <article class=\"la-pmtr-card\">\n          <img src=\"https://ledajans.com/wp-content/uploads/2025/11/11-预监回显形式丰富2_1742955187-e1763458137562.png\" alt=\"Colorlight PlayMaster önizleme ve izleme ekranı\">\n          <div class=\"la-pmtr-card-body\">\n            <h3>Zengin Önizleme ve İzleme</h3>\n            <p>Yayın öncesi ekran içeriğini hızlı doğrulayarak sahada daha güvenli kurulum ve kontrol sağlar.</p>\n          </div>\n        </article>\n    \n        <article class=\"la-pmtr-card\">\n          <img src=\"https://ledajans.com/wp-content/uploads/2025/11/13-Web控制简易配屏2_1742955230-e1763454690539.png\" alt=\"Web kontrol ile kolay LED ekran yapılandırma\">\n          <div class=\"la-pmtr-card-body\">\n            <h3>Web Kontrol ile Kolay Yapılandırma</h3>\n            <p>LED ekran ayarlarını sade bir akışla yapılandırır, sahada zaman kazandırır ve hata oranını düşürür.</p>\n          </div>\n        </article>\n    \n        <article class=\"la-pmtr-card\">\n          <img src=\"https://ledajans.com/wp-content/uploads/2025/11/05-超高画质极致享受2_1742954006.png\" alt=\"Colorlight yüksek görüntü kalitesi\">\n          <div class=\"la-pmtr-card-body\">\n            <h3>Yüksek Görüntü Kalitesi</h3>\n            <p>Doğru tarama ve kontrol parametreleri ile daha stabil, net ve profesyonel LED ekran performansı elde edilir.</p>\n          </div>\n        </article>\n      </div>\n    \n      <h2 class=\"la-pmtr-section-title\">İndirme Dosyaları</h2>\n      <div class=\"la-pmtr-downloads\">\n        <div class=\"la-pmtr-dl\">\n          <h3 class=\"la-pmtr-dl-title\">COLORLIGHT - PLAYMASTER TR</h3>\n          <p class=\"la-pmtr-dl-desc\">LED ekran yapılandırma ve yayın yönetimi için PlayMaster Türkçe indirme paketi.</p>\n          <a\n            href=\"https://drive.google.com/uc?export=download&id=1sDr9PZhZX1BdOgp78c5tPs32phQoetUe\"\n            target=\"_blank\"\n            rel=\"noopener noreferrer\">\n            Dosyayı İndir\n          </a>\n        </div>\n    \n        <div class=\"la-pmtr-dl\">\n          <h3 class=\"la-pmtr-dl-title\">PLAYERMASTER User Manual V1.4 TR</h3>\n          <p class=\"la-pmtr-dl-desc\">Kurulum adımları, tarama ayarları ve kullanım detayları için Türkçe kullanıcı kılavuzu.</p>\n          <a\n            href=\"https://ledajans.com/wp-content/uploads/2025/03/PlayerMaster-User-Manual-V1.4-TR.pdf\"\n            download=\"PlayerMaster-User-Manual-V1.4-TR.pdf\">Kılavuzu İndir</a>\n        </div>\n    \n        <div class=\"la-pmtr-dl\">\n          <h3 class=\"la-pmtr-dl-title\">LEDSETTINGS</h3>\n          <p class=\"la-pmtr-dl-desc\">LED ekran yapılandırma ve ayar yönetimi için Ledsettings indirme paketi (Google Drive).</p>\n          <a\n            href=\"https://drive.google.com/uc?export=download&id=1tfHaa5BL_iddhBFzyMCsYUXf04nPgJPD\"\n            target=\"_blank\"\n            rel=\"noopener noreferrer\">\n            Dosyayı İndir\n          </a>\n        </div>\n      </div>\n    \n      <div class=\"la-pmtr-seo\">\n        <p><strong>Colorlight PlayMaster TR</strong>, LED ekran sistemlerinde tarama, ekran eşleme ve yayın kontrol süreçlerini hızlandırmak için kullanılan profesyonel bir yönetim yazılımıdır.</p>\n        <p><strong>Ledsettings</strong> ile yapılandırma ve ayar süreçlerini destekleyebilirsiniz. Güncel dosyalar için bu sayfadaki indirme bağlantılarını kullanın.</p>\n        <p><a href=\"https://ledajans.com/colorlight/\">Colorlight</a> teknik destek içeriklerine <a href=\"https://ledajans.com\">Ledajans</a> üzerinden ulaşabilir, kurulum sonrası destek için ekibimizle iletişime geçebilirsiniz.</p>\n      </div>\n    \n    </div>\n    "
