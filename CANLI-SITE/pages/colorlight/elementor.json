       "html": "<!-- LEDAJANS - Colorlight Görsel Slider (Kesintisiz Sonsuz) -->\n<style>\n    .ledajans-colorlight-slider{\n      padding: 2.2rem 0;\n      background: #f9fafb;\n      overflow: hidden;\n      position: relative;\n    }\n    @media (min-width:768px){\n      .ledajans-colorlight-slider{ padding: 3rem 0; }\n    }\n    \n    .ledajans-colorlight-slider::before,\n    .ledajans-colorlight-slider::after{\n      content:\"\";\n      position:absolute;\n      top:0; bottom:0;\n      width:64px;\n      z-index:2;\n      pointer-events:none;\n    }\n    .ledajans-colorlight-slider::before{\n      left:0;\n      background: linear-gradient(90deg,#f9fafb 0%,rgba(249,250,251,0) 100%);\n    }\n    .ledajans-colorlight-slider::after{\n      right:0;\n      background: linear-gradient(270deg,#f9fafb 0%,rgba(249,250,251,0) 100%);\n    }\n    \n    .ledajans-colorlight-track{\n      display:flex;\n      width:max-content;\n      will-change: transform;\n      animation: ledajans-colorlight-scroll 28s linear infinite;\n    }\n    \n    .ledajans-colorlight-item{\n      flex:0 0 auto;\n      width:220px;\n      height:130px;\n      margin:0 .75rem;\n      border-radius:14px;\n      overflow:hidden;\n      background:#fff;\n      border:1px solid #e5e7eb;\n      box-shadow:0 6px 14px rgba(15,23,42,.06);\n    }\n    @media (min-width:768px){\n      .ledajans-colorlight-item{\n        width:300px;\n        height:170px;\n        margin:0 1rem;\n      }\n    }\n    \n    .ledajans-colorlight-item a{\n      display:block;\n      width:100%;\n      height:100%;\n    }\n    .ledajans-colorlight-item img{\n      width:100%;\n      height:100%;\n      object-fit:cover;\n      display:block;\n      transition:transform .25s ease;\n    }\n    .ledajans-colorlight-item:hover img{ transform:scale(1.03); }\n    \n    /* 3 set olduğu için 1 set kadar kaydırıp başa sarar */\n    @keyframes ledajans-colorlight-scroll{\n      from{ transform:translateX(0); }\n      to{ transform:translateX(-33.333%); }\n    }\n    </style>\n    \n    <section class=\"ledajans-colorlight-slider\" aria-label=\"Colorlight görsel slider\">\n      <div class=\"ledajans-colorlight-track\">\n    \n        <!-- SET 1 -->\n        <div class=\"ledajans-colorlight-item\"><a href=\"https://en.colorlightinside.com\" target=\"_blank\" rel=\"noopener noreferrer\"><img src=\"https://ledajans.com/wp-content/uploads/2025/11/5-内容_1672390674.png\" alt=\"Colorlight içerik yönetimi görseli\"></a></div>\n        <div class=\"ledajans-colorlight-item\"><a href=\"https://en.colorlightinside.com\" target=\"_blank\" rel=\"noopener noreferrer\"><img src=\"https://ledajans.com/wp-content/uploads/2025/11/11-预监回显形式丰富2_1742955187-e1763458137562.png\" alt=\"Colorlight önizleme ekranı\"></a></div>\n        <div class=\"ledajans-colorlight-item\"><a href=\"https://en.colorlightinside.com\" target=\"_blank\" rel=\"noopener noreferrer\"><img src=\"https://ledajans.com/wp-content/uploads/2025/11/13-Web控制简易配屏2_1742955230-e1763454690539.png\" alt=\"Colorlight web kontrol görseli\"></a></div>\n        <div class=\"ledajans-colorlight-item\"><a href=\"https://en.colorlightinside.com\" target=\"_blank\" rel=\"noopener noreferrer\"><img src=\"https://ledajans.com/wp-content/uploads/2025/11/05-超高画质极致享受2_1742954006.png\" alt=\"Colorlight yüksek görüntü kalitesi\"></a></div>\n    \n        <!-- SET 2 -->\n        <div class=\"ledajans-colorlight-item\"><a href=\"https://en.colorlightinside.com\" target=\"_blank\" rel=\"noopener noreferrer\"><img src=\"https://ledajans.com/wp-content/uploads/2025/11/5-内容_1672390674.png\" alt=\"Colorlight içerik yönetimi görseli\"></a></div>\n        <div class=\"ledajans-colorlight-item\"><a href=\"https://en.colorlightinside.com\" target=\"_blank\" rel=\"noopener noreferrer\"><img src=\"https://ledajans.com/wp-content/uploads/2025/11/11-预监回显形式丰富2_1742955187-e1763458137562.png\" alt=\"Colorlight önizleme ekranı\"></a></div>\n        <div class=\"ledajans-colorlight-item\"><a href=\"https://en.colorlightinside.com\" target=\"_blank\" rel=\"noopener noreferrer\"><img src=\"https://ledajans.com/wp-content/uploads/2025/11/13-Web控制简易配屏2_1742955230-e1763454690539.png\" alt=\"Colorlight web kontrol görseli\"></a></div>\n        <div class=\"ledajans-colorlight-item\"><a href=\"https://en.colorlightinside.com\" target=\"_blank\" rel=\"noopener noreferrer\"><img src=\"https://ledajans.com/wp-content/uploads/2025/11/05-超高画质极致享受2_1742954006.png\" alt=\"Colorlight yüksek görüntü kalitesi\"></a></div>\n    \n        <!-- SET 3 -->\n        <div class=\"ledajans-colorlight-item\"><a href=\"https://en.colorlightinside.com\" target=\"_blank\" rel=\"noopener noreferrer\"><img src=\"https://ledajans.com/wp-content/uploads/2025/11/5-内容_1672390674.png\" alt=\"Colorlight içerik yönetimi görseli\"></a></div>\n        <div class=\"ledajans-colorlight-item\"><a href=\"https://en.colorlightinside.com\" target=\"_blank\" rel=\"noopener noreferrer\"><img src=\"https://ledajans.com/wp-content/uploads/2025/11/11-预监回显形式丰富2_1742955187-e1763458137562.png\" alt=\"Colorlight önizleme ekranı\"></a></div>\n        <div class=\"ledajans-colorlight-item\"><a href=\"https://en.colorlightinside.com\" target=\"_blank\" rel=\"noopener noreferrer\"><img src=\"https://ledajans.com/wp-content/uploads/2025/11/13-Web控制简易配屏2_1742955230-e1763454690539.png\" alt=\"Colorlight web kontrol görseli\"></a></div>\n        <div class=\"ledajans-colorlight-item\"><a href=\"https://en.colorlightinside.com\" target=\"_blank\" rel=\"noopener noreferrer\"><img src=\"https://ledajans.com/wp-content/uploads/2025/11/05-超高画质极致享受2_1742954006.png\" alt=\"Colorlight yüksek görüntü kalitesi\"></a></div>\n    \n      </div>\n    </section>"
      },
      "elements": []
     }
    ]
   }
  ]
