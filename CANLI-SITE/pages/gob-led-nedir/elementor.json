ns-blog-hero-title { font-size: 3rem; } }\n    .ledajans-blog-hero-subtitle {\n      display: block;\n      margin-top: 0.5rem;\n      font-size: 0.875rem;\n      font-weight: 400;\n      color: #d1d5db;\n      letter-spacing: -0.01em;\n      line-height: 1.5;\n    }\n    @media (min-width: 640px) { .ledajans-blog-hero-subtitle { font-size: 1rem; } }\n    @media (min-width: 768px) { .ledajans-blog-hero-subtitle { font-size: 1.125rem; } }\n</style>\n\n<div class=\"ledajans-blog-hero\" role=\"img\" aria-label=\"GOB LED nedir — Glue on Board koruma yüzeyi\">\n  <div class=\"ledajans-blog-hero-overlay\"></div>\n  <div class=\"ledajans-blog-hero-inner\">\n    <div class=\"ledajans-blog-hero-content\">\n      <h1 class=\"ledajans-blog-hero-title\">GOB LED Nedir?</h1>\n      <span class=\"ledajans-blog-hero-subtitle\" style=\"color:#f46f2c\">Glue on Board · SMD üzerine epoksi · darbe ve nem koruması. <a href=\"https://ledajans.com/gob-led-ekran/\" style=\"color:#fff;text-decoration:underline;\">GOB ekran</a> · <a href=\"https://ledajans.com/gob-vs-cob-smd/\" style=\"color:#fff;text-decoration:underline;\">GOB vs COB</a> · <a href=\"https://ledajans.com/iletisim/\" style=\"color:#fff;text-decoration:underline;\">Teklif alın</a></span>\n    </div>\n  </div>\n</div>\n\n<script type=\"application/ld+json\">\n{\n  \"@context\": \"https://schema.org\",\n  \"@type\": \"BreadcrumbList\",\n  \"itemListElement\": [\n    {\"@type\":\"ListItem\",\"position\":1,\"name\":\"Anasayfa\",\"item\":\"https://ledajans.com/\"},\n    {\"@type\":\"ListItem\",\"position\":2,\"name\":\"LED Ekran\",\"item\":\"https://ledajans.com/led-ekran/\"},\n    {\"@type\":\"ListItem\",\"position\":3,\"name\":\"GOB LED Nedir?\",\"item\":\"https://ledajans.com/gob-led-nedir/\"}\n  ]\n}\n</script>"
