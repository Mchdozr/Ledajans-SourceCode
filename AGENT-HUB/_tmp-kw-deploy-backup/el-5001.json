[{"id":"566fbbb2","elType":"section","settings":[],"elements":[{"id":"2229d97e","elType":"column","settings":{"_column_size":100},"elements":[{"id":"6d7fbfac","elType":"widget","settings":{"editor":"<style>\n\n    .la-card { cursor: pointer; }\n    body.page-id-5001 .page-title,\n    body.page-id-5001 .page-title h1,\n    body.page-id-5001 .gva-breadcrumb-content h1,\n    body.page-id-5001 header.entry-header h1,\n    body.page-id-5001 .title-info > h1.title {\n      display: none !important;\n    }\n    /* LEDAJANS GLOBAL STİLLER */\n    :root {\n      --la-orange: #F46F2C;\n      --la-dark: #111827;\n      --la-gray: #4B5563;\n      --la-light: #F9FAFB;\n    }\n    \n    .la-wrapper {\n      font-family: system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;\n      color: #1f2937;\n      line-height: 1.7;\n      max-width: 1280px;\n      margin: 0 auto;\n      padding: 0 1rem;\n    }\n    \n    .la-section {\n      padding: 5rem 0;\n      border-bottom: 1px solid #f3f4f6;\n    }\n    \n    .la-section:last-child {\n      border-bottom: none;\n    }\n    \n    /* GRADYAN BAŞLIK */\n    @keyframes shine {\n      0% { background-position: 0% 50%; }\n      50% { background-position: 100% 50%; }\n      100% { background-position: 0% 50%; }\n    }\n    \n    .la-gradient-title {\n      font-size: 2.5rem;\n      font-weight: 900;\n      margin-bottom: 1.5rem;\n      line-height: 1.2;\n      background: linear-gradient(90deg, #F46F2C, #ff8f5e, #F46F2C);\n      background-size: 200% auto;\n      -webkit-background-clip: text;\n      -webkit-text-fill-color: transparent;\n      animation: shine 3s linear infinite;\n      text-align: center;\n    }\n    \n    @media (min-width: 768px) {\n      .la-gradient-title {\n        font-size: 3.75rem;\n      }\n    }\n    \n    /* HERO BÖLÜMÜ */\n    .la-hero {\n      background: linear-gradient(135deg, #111827 0%, #0f172a 100%);\n      border-radius: 2rem;\n      padding: 5rem 2rem;\n      color: white;\n      text-align: center;\n      margin-bottom: 3rem;\n      position: relative;\n      overflow: hidden;\n      box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.25);\n    }\n    \n    .la-hero::before {\n      content: '';\n      position: absolute;\n      top: -50%;\n      right: -20%;\n      width: 800px;\n      height: 800px;\n      background: radial-gradient(circle, rgba(244,111,44,0.1) 0%, rgba(0,0,0,0) 70%);\n      border-radius: 50%;\n      pointer-events: none;\n    }\n    \n    .la-hero-desc {\n      font-size: 1.25rem;\n      color: #9ca3af;\n      max-width: 800px;\n      margin: 0 auto 3rem;\n      font-weight: 300;\n    }\n    \n    /* BUTONLAR */\n    .la-btn {\n      display: inline-flex;\n      align-items: center;\n      justify-content: center;\n      padding: 1rem 2.5rem;\n      border-radius: 1rem;\n      font-weight: 700;\n      font-size: 1.1rem;\n      text-decoration: none;\n      transition: all 0.3s ease;\n      cursor: pointer;\n    }\n    \n    .la-btn-primary {\n      background-color: var(--la-orange);\n      color: #ffffff !important;\n      box-shadow: 0 10px 15px -3px rgba(244, 111, 44, 0.3);\n      border: 2px solid var(--la-orange);\n    }\n    \n    .la-btn-primary:hover {\n      background-color: #d1561b;\n      border-color: #d1561b;\n      transform: translateY(-3px);\n      box-shadow: 0 20px 25px -5px rgba(244, 111, 44, 0.4);\n      color: #ffffff !important;\n    }\n    \n    .la-btn-outline {\n      background: transparent;\n      color: white !important;\n      margin-left: 1rem;\n      border: 2px solid rgba(255,255,255,0.2);\n    }\n    \n    .la-btn-outline:hover {\n      background: rgba(255,255,255,0.1);\n      border-color: white;\n    }\n    \n    /* KARTLAR VE GÖRSELLER */\n    .la-grid-3 {\n      display: grid;\n      grid-template-columns: 1fr;\n      gap: 2.5rem;\n    }\n    \n    @media (min-width: 768px) {\n      .la-grid-3 {\n        grid-template-columns: repeat(3, 1fr);\n      }\n    }\n    \n    .la-card {\n      background: white;\n      border-radius: 1.5rem;\n      overflow: hidden;\n      border: 1px solid #e5e7eb;\n      transition: all 0.4s ease;\n      height: 100%;\n      display: flex;\n      flex-direction: column;\n      box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.05);\n    }\n    \n    .la-card:hover {\n      transform: translateY(-10px);\n      box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.15);\n      border-color: var(--la-orange);\n    }\n    \n    .la-card-img-wrapper {\n      position: relative;\n      padding-top: 62%;\n      overflow: hidden;\n      background-color: #f3f4f6;\n    }\n    \n    .la-card-img {\n      position: absolute;\n      inset: 0;\n      width: 100%;\n      height: 100%;\n      object-fit: cover;\n    }\n    \n    .la-card-body {\n      padding: 2rem;\n      flex-grow: 1;\n      display: flex;\n      flex-direction: column;\n    }\n    \n    .la-card-title {\n      font-size: 1.5rem;\n      font-weight: 800;\n      color: var(--la-dark);\n      margin-bottom: 1rem;\n    }\n    \n    .la-card-text {\n      color: var(--la-gray);\n      margin-bottom: 1.5rem;\n      flex-grow: 1;\n    }\n    \n    .la-link {\n      color: var(--la-orange);\n      font-weight: 700;\n      text-decoration: none;\n      display: inline-flex;\n      align-items: center;\n      gap: 0.5rem;\n      font-size: 1.1rem;\n    }\n    \n    .la-link:hover {\n      gap: 0.75rem;\n      text-decoration: underline;\n    }\n    \n    .la-link-icon {\n      display: inline-flex;\n      align-items: center;\n      justify-content: center;\n      width: 1.25rem;\n      height: 1.25rem;\n      border-radius: 999px;\n      border: 1px solid rgba(244, 111, 44, 0.4);\n      background: rgba(244, 111, 44, 0.06);\n      font-size: 0.8rem;\n      color: #f46f2c;\n    }\n    \n    /* SEO METİN ALANI */\n    .la-content-wrapper {\n      display: grid;\n      grid-template-columns: 1fr;\n      gap: 4rem;\n      align-items: center;\n    }\n    \n    @media (min-width: 1024px) {\n      .la-content-wrapper {\n        grid-template-columns: 1fr 1fr;\n      }\n    }\n    \n    .la-section-header {\n      font-size: 2.25rem;\n      font-weight: 800;\n      color: var(--la-dark);\n      margin-bottom: 1.5rem;\n      line-height: 1.2;\n    }\n    \n    .la-text-block p {\n      margin-bottom: 1.5rem;\n      font-size: 1.1rem;\n      color: #374151;\n    }\n    \n    .la-text-block a {\n      color: var(--la-orange);\n      text-decoration: underline;\n      font-weight: 600;\n    }\n    \n    /* SSS BÖLÜMÜ */\n    .la-faq-container {\n      max-width: 900px;\n      margin: 0 auto;\n    }\n    \n    .la-faq-item {\n      background: var(--la-light);\n      border-radius: 1rem;\n      padding: 2rem;\n      margin-bottom: 1.5rem;\n      border: 1px solid #e5e7eb;\n    }\n    \n    .la-faq-q {\n      font-size: 1.25rem;\n      font-weight: 700;\n      color: var(--la-dark);\n      margin-bottom: 1rem;\n    }\n    \n    /* ALT CTA */\n    .la-cta-box {\n      background: linear-gradient(135deg, #111827 0%, #000000 100%);\n      border-radius: 2rem;\n      padding: 5rem 2rem;\n      text-align: center;\n      margin-top: 4rem;\n      position: relative;\n      overflow: hidden;\n    }\n    \n    /* MOBİL */\n    @media (max-width: 640px) {\n      .la-hero {\n        padding: 3rem 1.5rem;\n      }\n    \n      .la-gradient-title {\n        font-size: 2.5rem;\n      }\n    \n      .la-btn {\n        width: 100%;\n        margin: 0.5rem 0 0 0;\n      }\n    \n      .la-btn-outline {\n        margin-left: 0;\n      }\n    \n      .la-content-wrapper {\n        gap: 2rem;\n      }\n    }\n    .la-link::before {\n      content: none !important;\n      display: none !important;\n    }\n    .la-link,\n    .la-link:hover,\n    .la-link:focus,\n    .la-link:active {\n      text-decoration: none !important;\n      border-bottom: none !important;\n    }\n    .la-card-img {\n      object-fit: cover;\n      object-position: center;\n    }\n    .la-card-img-contain {\n      object-fit: contain;\n      background: #111827;\n    }\n    .la-card-img-contain.la-card-img-light {\n      background: #fff;\n    }\n    </style>\n    <div class=\"la-wrapper\">\n    \n      <!-- HERO SECTION -->\n      <div class=\"la-hero\">\n        <h1 class=\"la-gradient-title\">LED Ekran Fiyatları ve Modelleri</h1>\n        <p class=\"la-hero-desc\">\n          <strong>LED ekran</strong> modellerini iç mekan, dış mekan ve rental olarak tek hub’da karşılaştırın.\n          m² fiyatı, P değeri ve kurulum kalemlerini netleştirip 25 yıllık üretici olarak Türkiye geneli teklif veriyoruz.\n        </p>\n        <div>\n          <a href=\"https://ledajans.com/iletisim/\" class=\"la-btn la-btn-primary\">LED Ekran Fiyat Teklifi Al</a>\n          <a href=\"https://ledajans.com/blog/led-ekran-fiyatlari-2026/\" class=\"la-btn la-btn-outline\">2026 Fiyat Rehberi</a>\n          <a href=\"https://ledajans.com/projeler/\" class=\"la-btn la-btn-outline\">Projeleri İncele</a>\n          <a href=\"tel:+902122204004\" class=\"la-btn la-btn-outline\">Hemen Ara: 0212 220 40 04</a>\n        </div>\n        <p style=\"margin-top:2rem;font-size:1rem;color:#9ca3af;max-width:720px;margin-left:auto;margin-right:auto;\">\n          <a href=\"https://ledajans.com/ic-mekan-led-ekran/\" style=\"color:#fdba74;text-decoration:none;font-weight:600;\">İç mekan LED ekran</a> ·\n          <a href=\"https://ledajans.com/dis-mekan-led-ekran/\" style=\"color:#fdba74;text-decoration:none;font-weight:600;\">Dış mekan LED ekran</a> ·\n          <a href=\"https://ledajans.com/rental-ekran/\" style=\"color:#fdba74;text-decoration:none;font-weight:600;\">Rental LED ekran kiralama</a> ·\n          <a href=\"https://ledajans.com/cob-ekran/\" style=\"color:#fdba74;text-decoration:none;font-weight:600;\">COB ekran</a>\n        </p>\n      </div>\n    \n      <!-- ÜRÜN KATEGORİLERİ (GÖRSELLİ & ZENGİN) -->\n      <div class=\"la-section\">\n        <div style=\"text-align: center; margin-bottom: 3rem;\">\n          <h2 class=\"la-section-header\">İhtiyacınıza Uygun LED Ekran Modelleri</h2>\n          <p style=\"font-size: 1.1rem; color: #6b7280; max-width: 700px; margin: 0 auto;\">\n            Projenizin kullanım alanına göre özel olarak tasarlanmış, farklı piksel aralıklarına ve kasa yapılarına sahip geniş ürün yelpazemizi inceleyin.\n          </p>\n        </div>\n    \n        <div class=\"la-grid-3\">\n          <!-- İç Mekan Kartı -->\n          <article class=\"la-card\"\n             onclick=\"window.location.href='https://ledajans.com/ic-mekan-led-ekran/';\">\n            <div class=\"la-card-img-wrapper\">\n              <img src=\"https://ledajans.com/wp-content/uploads/2026/09/ic-mekan-led-ekran.webp\"\n                   alt=\"İç mekan LED ekran — mağaza ve stüdyo indoor panel\"\n                   class=\"la-card-img\" width=\"1200\" height=\"750\" loading=\"lazy\" decoding=\"async\">\n            </div>\n            <div class=\"la-card-body\">\n              <h3 class=\"la-card-title\">İç Mekan (Indoor) LED Ekran</h3>\n              <p class=\"la-card-text\">\n                Mağaza vitrinleri, toplantı salonları ve TV stüdyoları için\n                <strong>P1.25, P2, P2.5</strong> gibi yüksek çözünürlüklü seçenekler. Sessiz çalışan,\n                ince kasalı ve yüksek tazeleme hızına (3840Hz) sahip ekranlar.\n              </p>\n              <a href=\"https://ledajans.com/ic-mekan-led-ekran/\"\n                 class=\"la-link\"\n                 title=\"İç Mekan LED Ekran Modelleri\">\n                Modelleri İncele\n                <span class=\"la-link-icon\" aria-hidden=\"true\">➜</span>\n              </a>\n            </div>\n          </article>\n    \n          <!-- Dış Mekan Kartı -->\n          <article class=\"la-card\"\n             onclick=\"window.location.href='https://ledajans.com/dis-mekan-led-ekran/';\">\n            <div class=\"la-card-img-wrapper\">\n              <img src=\"https://ledajans.com/wp-content/uploads/2026/09/dis-mekan-outdoor-led-v2.webp\"\n                   alt=\"Dış mekan LED ekran — IP65 outdoor reklam paneli\"\n                   class=\"la-card-img\" width=\"1200\" height=\"1200\" loading=\"lazy\" decoding=\"async\">\n            </div>\n            <div class=\"la-card-body\">\n              <h3 class=\"la-card-title\">Dış Mekan (Outdoor) LED Ekran</h3>\n              <p class=\"la-card-text\">\n                Güneş altında net görünen 5000+ nits parlaklık. Yağmur, kar ve toza dayanıklı\n                <strong>IP65 korumalı</strong> paneller. Reklam panoları, totemler ve stadyumlar için\n                <strong>P4, P5, P6, P8, P10</strong> seçenekleri.\n              </p>\n              <a href=\"https://ledajans.com/dis-mekan-led-ekran/\"\n                 class=\"la-link\"\n                 title=\"Dış Mekan LED Ekran Fiyatları\">\n                Modelleri İncele\n                <span class=\"la-link-icon\" aria-hidden=\"true\">➜</span>\n              </a>\n            </div>\n          </article>\n    \n          <!-- Rental Kartı -->\n          <article class=\"la-card\"\n             onclick=\"window.location.href='https://ledajans.com/rental-ekran/';\">\n            <div class=\"la-card-img-wrapper\">\n              <img src=\"https://ledajans.com/wp-content/uploads/2022/12/untitled.232-min-1.png\"\n                   alt=\"Rental LED ekran kiralama — konser ve fuar kabini\"\n                   class=\"la-card-img\" width=\"800\" height=\"600\" loading=\"lazy\" decoding=\"async\">\n            </div>\n            <div class=\"la-card-body\">\n              <h3 class=\"la-card-title\">Rental (Kiralık) LED Ekran</h3>\n              <p class=\"la-card-text\">\n                Konser, fuar ve etkinlikler için hızlı kurulup sökülebilen, hafif\n                <strong>die-cast alüminyum</strong> kasa yapısı. Mobil kullanım için özel kilit\n                sistemleri ve taşıma çantaları (flight case) ile.\n              </p>\n              <a href=\"https://ledajans.com/rental-ekran/\"\n                 class=\"la-link\"\n                 title=\"Rental LED Ekran Kiralama\">\n                Modelleri İncele\n                <span class=\"la-link-icon\" aria-hidden=\"true\">➜</span>\n              </a>\n            </div>\n          </article>\n\n          <!-- COB - Smart Screen Kartı -->\n          <article class=\"la-card\"\n             onclick=\"window.location.href='https://ledajans.com/cob-ekran/';\">\n            <div class=\"la-card-img-wrapper\">\n              <img src=\"https://ledajans.com/wp-content/uploads/2026/09/cob-smart-screen.webp\"\n                   alt=\"COB Smart Screen LED ekran paneli\"\n                   class=\"la-card-img la-card-img-contain la-card-img-light\" width=\"1024\" height=\"505\" loading=\"lazy\" decoding=\"async\">\n            </div>\n            <div class=\"la-card-body\">\n              <h3 class=\"la-card-title\">COB – Smart Screen</h3>\n              <p class=\"la-card-text\">\n                Yüksek dayanıklılık ve premium görüntü kalitesi sunan COB teknolojisi,\n                kurumsal alanlar ve uzun ömürlü ekran ihtiyaçları için ideal çözüm sağlar.\n              </p>\n              <a href=\"https://ledajans.com/cob-ekran/\"\n                 class=\"la-link\"\n                 title=\"COB - Smart Screen Detayları\">\n                Modelleri İncele\n                <span class=\"la-link-icon\" aria-hidden=\"true\">➜</span>\n              </a>\n            </div>\n          </article>\n\n          <!-- İç Mekan RGB Panel Kartı -->\n          <article class=\"la-card\"\n             onclick=\"window.location.href='https://ledajans.com/ic-mekan-rgb-panel/';\">\n            <div class=\"la-card-img-wrapper\">\n              <img src=\"https://ledajans.com/wp-content/uploads/2026/09/ic-mekan-rgb-panel.webp\"\n                   alt=\"İç mekan RGB panel — showroom LED duvar\"\n                   class=\"la-card-img\" width=\"1200\" height=\"800\" loading=\"lazy\" decoding=\"async\">\n            </div>\n            <div class=\"la-card-body\">\n              <h3 class=\"la-card-title\">İç Mekan RGB Panel</h3>\n              <p class=\"la-card-text\">\n                Mağaza, showroom ve kurumsal uygulamalar için canlı renk performansı sunan\n                iç mekan RGB panel seçeneklerini inceleyin.\n              </p>\n              <a href=\"https://ledajans.com/ic-mekan-rgb-panel/\"\n                 class=\"la-link\"\n                 title=\"İç Mekan RGB Panel Modelleri\">\n                Modelleri İncele\n                <span class=\"la-link-icon\" aria-hidden=\"true\">➜</span>\n              </a>\n            </div>\n          </article>\n\n          <!-- Dış Mekan RGB Panel Kartı -->\n          <article class=\"la-card\"\n             onclick=\"window.location.href='https://ledajans.com/dis-mekan-rgb-panel/';\">\n            <div class=\"la-card-img-wrapper\">\n              <img src=\"https://ledajans.com/wp-content/uploads/2026/09/dis-mekan-rgb-panel.webp\"\n                   alt=\"Dış mekan RGB panel — outdoor LED kabin\"\n                   class=\"la-card-img la-card-img-contain\" width=\"1024\" height=\"505\" loading=\"lazy\" decoding=\"async\">\n            </div>\n            <div class=\"la-card-body\">\n              <h3 class=\"la-card-title\">Dış Mekan RGB Panel</h3>\n              <p class=\"la-card-text\">\n                Zorlu hava koşullarına dayanıklı, yüksek parlaklık ve uzun ömür sunan\n                dış mekan RGB panel ürünleriyle projelerinizi güçlendirin.\n              </p>\n              <a href=\"https://ledajans.com/dis-mekan-rgb-panel/\"\n                 class=\"la-link\"\n                 title=\"Dış Mekan RGB Panel Modelleri\">\n                Modelleri İncele\n                <span class=\"la-link-icon\" aria-hidden=\"true\">➜</span>\n              </a>\n            </div>\n          </article>\n\n        </div>\n      </div>\n    \n      <!-- SEO METİN ALANI (Görsel Destekli) -->\n      <div class=\"la-section\">\n        <div class=\"la-content-wrapper\">\n          <div class=\"la-text-block\">\n            <h2 class=\"la-section-header\">LED Ekran Nedir ve İşletmenize Ne Kazandırır?</h2>\n            <p>\n              <strong>LED ekran</strong>, binlerce küçük LED çipinin bir araya gelerek oluşturduğu, günümüzün en etkili dijital görüntüleme teknolojisidir. Geleneksel tabelaların aksine, <a href=\"https://ledajans.com/cob-ekran/\">hareketli videolar</a> ve dinamik içerikler yayınlayarak müşterilerinizin dikkatini %400 daha fazla çekersiniz.\n            </p>\n            <p>\n              LEDAJANS olarak sunduğumuz <strong>LED ekran sistemleri</strong>, modüler yapısı sayesinde mekanınıza özel (örneğin 3x2 metre veya 10x5 metre) üretilir. <a href=\"https://ledajans.com/ic-mekan-led-ekran/\">İç mekan LED ekran</a> modelleri mağaza, stüdyo ve toplantı odalarında tercih edilirken, <a href=\"https://ledajans.com/dis-mekan-led-ekran/\">dış mekan LED ekran çözümleri</a> reklam panoları ve stadyumlarda markanızın prestijini artırır. Kısa süreli projeler için <a href=\"https://ledajans.com/rental-ekran/\">rental LED ekran kiralama</a> seçeneklerimiz de mevcuttur.\n            </p>\n            <p>\n              Doğru <strong>LED ekran</strong> seçimi izleme mesafesi, parlaklık (nits) ve IP sınıfıyla başlar; fiyat ise P değeri + m² + kontrol + kurulum toplamıdır.\n              Model karşılaştırması için bu sayfayı, marka ve keşif için <a href=\"https://ledajans.com/\">LEDAJANS ana sayfasını</a> kullanın.\n            </p>\n            <ul style=\"list-style: none; padding: 0; display: grid; gap: 1rem; margin-top: 2rem;\">\n              <li style=\"display: flex; align-items: center; gap: 1rem; font-weight: 600;\">\n                <span style=\"color: var(--la-orange);\">✓</span> 100.000 Saate Varan Uzun Ömür\n              </li>\n              <li style=\"display: flex; align-items: center; gap: 1rem; font-weight: 600;\">\n                <span style=\"color: var(--la-orange);\">✓</span> Düşük Enerji Tüketimi (Eco Modül)\n              </li>\n              <li style=\"display: flex; align-items: center; gap: 1rem; font-weight: 600;\">\n                <span style=\"color: var(--la-orange);\">✓</span> Uzaktan Yönetim Yazılımı\n              </li>\n            </ul>\n            <h3 class=\"la-card-title\" style=\"margin-top:2rem;\">LED ekran tipi nasıl seçilir?</h3>\n            <div style=\"overflow-x:auto;margin-top:1rem;\">\n              <table style=\"width:100%;border-collapse:collapse;font-size:0.95rem;\">\n                <thead>\n                  <tr style=\"background:#111827;color:#fff;\">\n                    <th style=\"padding:0.75rem;text-align:left;\">Kullanım</th>\n                    <th style=\"padding:0.75rem;text-align:left;\">Tip</th>\n                    <th style=\"padding:0.75rem;text-align:left;\">Pitch</th>\n                  </tr>\n                </thead>\n                <tbody>\n                  <tr style=\"border-bottom:1px solid #e5e7eb;\"><td style=\"padding:0.75rem;\">Mağaza, stüdyo</td><td style=\"padding:0.75rem;\">İç mekan</td><td style=\"padding:0.75rem;\">P1.25–P3</td></tr>\n                  <tr style=\"border-bottom:1px solid #e5e7eb;\"><td style=\"padding:0.75rem;\">Cephe, billboard</td><td style=\"padding:0.75rem;\">Dış mekan IP65</td><td style=\"padding:0.75rem;\">P4–P10</td></tr>\n                  <tr><td style=\"padding:0.75rem;\">Konser, fuar</td><td style=\"padding:0.75rem;\">Rental</td><td style=\"padding:0.75rem;\">P2.6–P4.8</td></tr>\n                </tbody>\n              </table>\n            </div>\n          </div>\n          <div>\n            <img src=\"https://ledajans.com/wp-content/uploads/2026/09/dis-mekan-led-ekran-referans.webp\"\n                 alt=\"LED ekran paneli — LEDAJANS üretim ve kurulum\"\n                 width=\"1200\" height=\"1600\"\n                 style=\"width: 100%; height: auto; border-radius: 2rem; box-shadow: 0 25px 50px -12px rgba(0,0,0,0.2);\"\n                 loading=\"lazy\" decoding=\"async\">\n          </div>\n        </div>\n      </div>\n    \n      <!-- REHBERLER VE FİYAT (long-tail iç link kümesi) -->\n      <div class=\"la-section\" style=\"padding: 3rem 1rem;\">\n        <h2 class=\"la-section-header\" style=\"text-align: center; margin-bottom: 2rem;\">Rehberler ve fiyat</h2>\n        <div style=\"display: grid; grid-template-columns: repeat(auto-fit, minmax(260px, 1fr)); gap: 1rem; max-width: 1100px; margin: 0 auto;\">\n          <a href=\"https://ledajans.com/blog/led-ekran-fiyatlari-2026/\" style=\"display:block;padding:1.25rem;border:1px solid #e5e7eb;border-radius:1rem;text-decoration:none;color:#111827;background:#fff;\">\n            <strong style=\"color:#F46F2C;\">LED ekran fiyatları 2026</strong>\n            <p style=\"margin:0.5rem 0 0;font-size:0.9rem;color:#6b7280;\">İç/dış mekan ve rental bütçe rehberi</p>\n          </a>\n          <a href=\"https://ledajans.com/blog/led-ekran-nasil-secilir-rehber/\" style=\"display:block;padding:1.25rem;border:1px solid #e5e7eb;border-radius:1rem;text-decoration:none;color:#111827;background:#fff;\">\n            <strong style=\"color:#F46F2C;\">LED ekran nasıl seçilir?</strong>\n            <p style=\"margin:0.5rem 0 0;font-size:0.9rem;color:#6b7280;\">P değeri, kasa ve kontrol seçimi</p>\n          </a>\n          <a href=\"https://ledajans.com/blog/ic-mekan-led-ekran-fiyatlari-2026/\" style=\"display:block;padding:1.25rem;border:1px solid #e5e7eb;border-radius:1rem;text-decoration:none;color:#111827;background:#fff;\">\n            <strong style=\"color:#F46F2C;\">İç mekan fiyat rehberi</strong>\n            <p style=\"margin:0.5rem 0 0;font-size:0.9rem;color:#6b7280;\">P0.93–P5 m² bütçe aralıkları</p>\n          </a>\n          <a href=\"https://ledajans.com/blog/dis-mekan-led-ekran-fiyatlari-2026/\" style=\"display:block;padding:1.25rem;border:1px solid #e5e7eb;border-radius:1rem;text-decoration:none;color:#111827;background:#fff;\">\n            <strong style=\"color:#F46F2C;\">Dış mekan fiyat rehberi</strong>\n            <p style=\"margin:0.5rem 0 0;font-size:0.9rem;color:#6b7280;\">IP65 ve P4–P10 maliyet kalemleri</p>\n          </a>\n          <a href=\"https://ledajans.com/blog/rental-led-ekran-kiralama-fiyatlari-2026/\" style=\"display:block;padding:1.25rem;border:1px solid #e5e7eb;border-radius:1rem;text-decoration:none;color:#111827;background:#fff;\">\n            <strong style=\"color:#F46F2C;\">Rental kiralama fiyatları</strong>\n            <p style=\"margin:0.5rem 0 0;font-size:0.9rem;color:#6b7280;\">Gün + m² + lokasyon formülü</p>\n          </a>\n          <a href=\"https://ledajans.com/fuar-led-ekran/\" style=\"display:block;padding:1.25rem;border:1px solid #e5e7eb;border-radius:1rem;text-decoration:none;color:#111827;background:#fff;\">\n            <strong style=\"color:#F46F2C;\">Fuar LED ekran rehberi</strong>\n            <p style=\"margin:0.5rem 0 0;font-size:0.9rem;color:#6b7280;\">Stand ve etkinlik senaryoları</p>\n          </a>\n          <a href=\"https://ledajans.com/led-ekran-nedir/\" style=\"display:block;padding:1.25rem;border:1px solid #e5e7eb;border-radius:1rem;text-decoration:none;color:#111827;background:#fff;\">\n            <strong style=\"color:#F46F2C;\">LED ekran nedir?</strong>\n            <p style=\"margin:0.5rem 0 0;font-size:0.9rem;color:#6b7280;\">Türler, kullanım ve seçim kriterleri</p>\n          </a>\n          <a href=\"https://ledajans.com/led-ekran-bakim/\" style=\"display:block;padding:1.25rem;border:1px solid #e5e7eb;border-radius:1rem;text-decoration:none;color:#111827;background:#fff;\">\n            <strong style=\"color:#F46F2C;\">LED ekran bakım rehberi</strong>\n            <p style=\"margin:0.5rem 0 0;font-size:0.9rem;color:#6b7280;\">Temizlik, arıza ve parça ömrü</p>\n          </a>\n          <a href=\"https://ledajans.com/toplanti-odasi-led-ekran/\" style=\"display:block;padding:1.25rem;border:1px solid #e5e7eb;border-radius:1rem;text-decoration:none;color:#111827;background:#fff;\">\n            <strong style=\"color:#F46F2C;\">Toplantı odası LED ekran</strong>\n            <p style=\"margin:0.5rem 0 0;font-size:0.9rem;color:#6b7280;\">Indoor pitch, mesafe ve kurulum</p>\n          </a>\n        </div>\n      </div>\n\n      <!-- SIK SORULAN SORULAR (SEO Zenginleştirilmiş) -->\n      <div class=\"la-section\" style=\"background-color: #fcfcfc; border-radius: 2rem; padding: 4rem 2rem;\">\n        <div style=\"text-align: center; margin-bottom: 3rem;\">\n          <h2 class=\"la-section-header\">LED Ekran Hakkında Merak Edilenler</h2>\n          <p style=\"color: #6b7280;\">Satın alma kararınızı vermeden önce en çok sorulan soruları yanıtladık.</p>\n        </div>\n    \n        <div class=\"la-faq-container\">\n          <div class=\"la-faq-item\">\n            <h3 class=\"la-faq-q\">LED ekran m² fiyatları neye göre değişir?</h3>\n            <p class=\"la-faq-a\">\n              <strong>LED ekran fiyatları</strong>; seçilen piksel aralığına (P değeri küçüldükçe fiyat artar), ekranın toplam boyutuna, kullanılan LED çip kalitesine (Nationstar, Kinglight vb.) ve kontrol sistemine (Novastar, Huidu) göre belirlenir. En doğru fiyat için <a href=\"https://ledajans.com/iletisim/\">bizimle iletişime geçin</a>.\n            </p>\n          </div>\n    \n          <div class=\"la-faq-item\">\n            <h3 class=\"la-faq-q\">Piksel (P) değeri nedir, hangisini seçmeliyim?</h3>\n            <p class=\"la-faq-a\">\n              P değeri, iki LED arasındaki milimetre cinsinden mesafedir. İzleme mesafesi kısaldıkça P değeri düşmelidir. \n              <br>• <strong>Yakın izleme (2-5m):</strong> P1.8, P2, P2.5 (Mağaza içi, Vitrin)\n              <br>• <strong>Orta mesafe (5-10m):</strong> P3, P4, P5 (Dış cephe, Totem)\n              <br>• <strong>Uzak mesafe (10m+):</strong> P6, P8, P10 (Bina çatısı, Stadyum)\n            </p>\n          </div>\n    \n          <div class=\"la-faq-item\">\n            <h3 class=\"la-faq-q\">Garanti ve teknik servis süreciniz nasıl?</h3>\n            <p class=\"la-faq-a\">\n              Tüm LED ekran projelerimiz <strong>2 yıl tam parça garantilidir</strong>. İstanbul merkezli teknik servis ekibimiz, olası arızalara yerinde veya uzaktan bağlantı ile anında müdahale eder. Bakım adımları için <a href=\"https://ledajans.com/led-ekran-bakim/\">LED ekran bakım rehberine</a>, kurulum videoları için <a href=\"https://ledajans.com/teknik-destek-videolari/\">teknik destek videolarına</a> bakın.\n            </p>\n          </div>\n\n          <div class=\"la-faq-item\">\n            <h3 class=\"la-faq-q\">LED ekran nasıl seçilir?</h3>\n            <p class=\"la-faq-a\">\n              Önce izleme mesafesini ölçün, ardından iç/dış ortamı netleştirin. Yakın mağaza için P2–P2.5 indoor; güneşli cephe için P4–P10 ve IP65 outdoor; kısa süreli etkinlik için rental kabin doğru ailedir.\n              Adım adım kontrol listesi: <a href=\"https://ledajans.com/blog/led-ekran-nasil-secilir-rehber/\">LED ekran nasıl seçilir</a>.\n            </p>\n          </div>\n\n          <div class=\"la-faq-item\">\n            <h3 class=\"la-faq-q\">LED ekran firması seçerken nelere bakmalıyım?</h3>\n            <p class=\"la-faq-a\">\n              Üretici mi yoksa yalnızca satıcı mı, yerinde keşif, yedek parça stoğu ve yazılı garanti kritiktir. LEDAJANS İstanbul merkezli üretim ve kurulum ekibiyle <strong>LED ekran firmaları</strong> arasında doğrudan üretici desteği verir.\n            </p>\n          </div>\n        </div>\n      </div>\n    \n      <!-- ALT CTA: Gradyan Başlıklı -->\n      <div class=\"la-cta-box\">\n        <h2 class=\"la-gradient-title\" style=\"margin-bottom: 1rem;\">Projenizi Hayata Geçirelim</h2>\n        <p style=\"font-size: 1.25rem; color: #d1d5db; margin-bottom: 2.5rem; max-width: 700px; margin-left: auto; margin-right: auto;\">\n          İşletmenizin görünürlüğünü artırmak için en doğru adımı atın. Uzmanlarımız size özel <strong>LED ekran</strong> projesini ve fiyat teklifini hazırlasın.\n        </p>\n        <a href=\"https://ledajans.com/iletisim/\"\n           class=\"la-btn la-btn-primary\"\n           style=\"font-size: 1.25rem; padding: 1.25rem 3rem;\">\n          Bize Ulaşın\n        </a>\n      </div>\n    \n    </div>\n\n<script type=\"application/ld+json\">\n{\n  \"@context\": \"https://schema.org\",\n  \"@type\": \"FAQPage\",\n  \"mainEntity\": [\n    {\n      \"@type\": \"Question\",\n      \"name\": \"LED ekran m² fiyatları neye göre değişir?\",\n      \"acceptedAnswer\": {\n        \"@type\": \"Answer\",\n        \"text\": \"LED ekran fiyatları; seçilen piksel aralığına (P değeri küçüldükçe fiyat artar), ekranın toplam boyutuna, kullanılan LED çip kalitesine (Nationstar, Kinglight vb.) ve kontrol sistemine (Novastar, Huidu) göre belirlenir. En doğru fiyat için Ledajans ile iletişime geçin.\"\n      }\n    },\n    {\n      \"@type\": \"Question\",\n      \"name\": \"Piksel (P) değeri nedir, hangisini seçmeliyim?\",\n      \"acceptedAnswer\": {\n        \"@type\": \"Answer\",\n        \"text\": \"P değeri, iki LED arasındaki milimetre cinsinden mesafedir. Yakın izleme (2-5m) için P1.8, P2, P2.5; orta mesafe (5-10m) için P3, P4, P5; uzak mesafe (10m+) için P6, P8, P10 tercih edilmelidir.\"\n      }\n    },\n    {\n      \"@type\": \"Question\",\n      \"name\": \"Garanti ve teknik servis süreciniz nasıl?\",\n      \"acceptedAnswer\": {\n        \"@type\": \"Answer\",\n        \"text\": \"Tüm LED ekran projelerimiz 2 yıl tam parça garantilidir. İstanbul merkezli teknik servis ekibimiz yerinde veya uzaktan müdahale eder. Bakım: https://ledajans.com/led-ekran-bakim/ Videolar: https://ledajans.com/teknik-destek-videolari/\"\n      }\n    },\n    {\n      \"@type\": \"Question\",\n      \"name\": \"LED ekran nasıl seçilir?\",\n      \"acceptedAnswer\": {\n        \"@type\": \"Answer\",\n        \"text\": \"Önce izleme mesafesini ölçün, ardından iç veya dış