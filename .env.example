# WordPress REST API (Uygulama Şifresi — WP Admin → Profil → Uygulama Şifreleri)
# Kökte .env oluşturun: copy .env.example .env  (veya deploy script bunu okur)
WP_SITE_URL=https://ledajans.com
WP_USERNAME=ledajans
WP_APP_PASSWORD=

# Şifrede boşluk olsa da olur; deploy script boşlukları otomatik siler.
# Eski şifre repoda commit edildiyse WP Admin'den SİLİN, yenisini oluşturun.
# Blog yükleme: python deploy-to-wordpress.py --blog-only
# Yayın:        python deploy-to-wordpress.py --blog-only --publish
